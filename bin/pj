#!/usr/bin/env bash
# Thin launcher for the projects registry CLI, which lives in the private
# overlay repo reached through the fixed path ~/.config/private (see
# README.md "Private overlay"). Point PJ_BIN at it to override.
set -euo pipefail

pj_bin="${PJ_BIN:-$HOME/.config/private/hermes/skills/workspaces/projects/registry/scripts/pj}"

if [[ ! -f $pj_bin ]]; then
  echo "pj: cannot locate the projects registry CLI at $pj_bin" >&2
  echo "pj: install the private-dotconfig overlay, or set PJ_BIN." >&2
  exit 127
fi

exec python3 "$pj_bin" "$@"
