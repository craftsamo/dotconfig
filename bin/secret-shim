#!/bin/zsh -f
# secret-shim — thin launcher that injects Keychain secrets, then execs the
# real command. Three modes, selected by which launcher the command's
# symlink points at (see "Usage" below):
#
# -f (NO_RCS): never source ~/.zshenv etc. — the shim must see the caller's
# PATH exactly as-is, so the "real binary" lookup below stays predictable.
# PATH construction is zsh/env.zsh's job, done by the shell that runs us.
#
#   tool mode (-> secret-shim: opencode, claude, codex, copilot, grok, ...)
#     secret env -p global      layer shared by every tool
#     secret env -p <command>   tool-specific layer (overrides global)
#
#   project mode (-> secret-shim-project: npm, node, bun, python, uv, docker, ...)
#     secret env                ambient project + repository scope, i.e. the
#                               secrets of the repository you are in, in the
#                               stage SECRET_STAGE names (prod, test, ...;
#                               none by default: a staged value is never
#                               injected unless asked for)
#     Injected only inside a git repository (never falls back to the
#     "global" project), and only for names that are not already defined
#     in a dotenv file — the application's own .env loader keeps priority.
#
#   plain mode (-> secret-shim-plain: pip, pip3)
#     no secrets; the launcher exists only for the mise pin below
#
# Tool layers are always the stage-less shared layers (--no-stage): a stage
# set in the shell never reaches an AI CLI. A project launch in stage prod
# or production says so on stderr, so a shell left in prod is noticed.
#
# Every mode pins mise's directories to the account's real home before the
# exec (see _pin_mise_dirs).
#
# Effective precedence in both modes:
#   explicitly exported environment  >  .env files (project mode)  >  Keychain
# What a shim injected is not "explicitly exported": a project launch under
# a tool (opencode running npm) replaces the tool's values with the
# repository's where both hold a name (_SECRET_SHIM_TOOL_NAMES).
#
# Dotenv detection (project mode) collects variable *names* (values are
# never read) from .env, .env.local and .env.{development,production,test}
# {,.local} — in every directory from $PWD up to the git toplevel, plus the
# subtree below $PWD (node_modules/.git pruned, depth-limited), so monorepo
# package files like apps/web/.env are respected when launching from the
# workspace root. Under SECRET_STAGE only .env, .env.local and the stage's
# own .env.<stage>{,.local} count (prod = production, dev = development), so
# another stage's file never keeps the asked-for stage's value out.
# Templates (.env.example, ...) are deliberately ignored.
#
# Usage: symlink a command name to the launcher of its mode:
#   ln -s secret-shim         ~/.config/bin/<command>   tool
#   ln -s secret-shim-project ~/.config/bin/<command>   project
#   ln -s secret-shim-plain   ~/.config/bin/<command>   plain
# Nested launches are detected via _SECRET_SHIM_TOOL/_SECRET_SHIM_PROJ
# (project@stage) and skip re-injection. A nested project launch in another
# stage (or project) first retracts what the parent shim injected — the
# names are carried in _SECRET_SHIM_NAMES — then injects the new layers, so
# the environment holds one stage's values, never a mix; it says so on
# stderr, with how many names came in. If the keychain cannot be unlocked, injection is
# skipped and the command starts anyway. The only fail-closed exception is
# `opencode serve`, which requires OPENCODE_PASSWORD or OPENCODE_SERVER_PASSWORD.
# (OpenCode 2's background service is spawned by opencode itself, not
# through this shim, and keeps its own generated password.)
#
# Test hooks: SECRET_SHIM_MODE forces the mode (tool|project|plain),
# SECRET_SHIM_BASE replaces "global" as the tool-mode base project,
# SECRET_SHIM_LIB points at the secret.zsh to source (a candidate checkout).

emulate zsh

name=${0:t}
self=${0:A}
lib=${SECRET_SHIM_LIB:-$HOME/.config/zsh/functions/secret.zsh}

# The launcher a command is linked to declares its mode — no name table:
#   ln -s secret-shim         ~/.config/bin/<cmd>   tool mode
#   ln -s secret-shim-project ~/.config/bin/<cmd>   project mode
#   ln -s secret-shim-plain   ~/.config/bin/<cmd>   plain mode
# (secret-shim-project and -plain are themselves links to secret-shim). The
# chain from $0 is followed one link at a time until a launcher's name shows
# up, so a link to a link still lands on its mode; zstat, not readlink, so a
# stripped PATH (cron, env -i) cannot change the answer.
zmodload -F zsh/stat b:zstat
mode=tool
_p=$0 _t="" _i=0
while (( _i++ < 8 )) && _t=$(zstat -L +link -- "$_p" 2>/dev/null) && [[ -n $_t ]]; do
  case ${_t:t} in
    secret-shim-project) mode=project; break ;;
    secret-shim-plain)   mode=plain; break ;;
    secret-shim)         break ;;
  esac
  [[ $_t == /* ]] || _t=${_p:h}/$_t
  _p=$_t
done
unset _p _t _i
[[ -n ${SECRET_SHIM_MODE:-} ]] && mode=$SECRET_SHIM_MODE
base=${SECRET_SHIM_BASE:-global}

# names exported before the shim ran — never overridden
typeset -A _had _skip
for _k in ${(k)parameters[(R)*export*]}; do _had[$_k]=1; done
typeset -a _injected           # names this run injected (exported to children, see below)

_inject() {                    # args are passed to `secret env`
  local line n
  for line in ${(f)"$(secret env "$@" 2>/dev/null)"}; do
    [[ $line == export\ * ]] || continue
    n=${${line#export }%%=*}
    [[ -n ${_had[$n]:-} || -n ${_skip[$n]:-} ]] && continue
    eval "$line"
    _injected+=("$n")
  done
}

# A nested project launch in another stage (or project): the values a parent
# shim injected are not the user's own exports, so they go before the new
# layers come in — the environment reflects one project@stage, never a mix
# of two. _SECRET_SHIM_NAMES lists what the parent injected; a name the user
# exported by hand is not in it and keeps winning.
_retract() {
  local n
  for n in ${=_SECRET_SHIM_NAMES:-}; do
    [[ -n $n && $n != [0-9]* && -z ${n//[A-Za-z0-9_]/} ]] || continue   # identifiers only
    [[ ${parameters[$n]:-} == *export* ]] || continue                     # only what a shim could have set
    unset "$n"
    unset "_had[$n]"
  done
}

# A project launch under a tool (opencode running `npm run dev` in a
# repository): the tool's layers were injected for the tool, not for the
# repository, so the names the tool shim injected (_SECRET_SHIM_TOOL_NAMES)
# may be replaced by the repository's own — the more specific layer wins,
# as between shared and scoped. A tool value the repository has no
# counterpart for stays; a value the user exported by hand is not in the
# list and keeps winning.
_release_tool_names() {
  local n
  for n in ${=_SECRET_SHIM_TOOL_NAMES:-}; do
    [[ -n $n && $n != [0-9]* && -z ${n//[A-Za-z0-9_]/} ]] || continue
    unset "_had[$n]"
  done
}

_scan_dotenv() {               # $1 git toplevel  $2 stage; fills _skip with dotenv names
  local -a bases files args
  # Which files count depends on the stage. With none, every one the
  # application might read; with a stage, only .env, .env.local and that
  # stage's own pair — another stage's file must not keep the asked-for
  # stage's keychain value out. prod/production and dev/development name
  # the same files.
  bases=(.env .env.local)
  local s=$2
  case $s in
    prod) s=production ;;
    dev)  s=development ;;
  esac
  if [[ -z $s ]]; then
    bases+=(.env.development .env.development.local
            .env.production .env.production.local .env.test .env.test.local)
  else
    bases+=(".env.$s" ".env.$s.local")
  fi
  local d=$PWD f
  while true; do               # ancestors: $PWD up to the toplevel
    for f in $bases; do [[ -f $d/$f ]] && files+=("$d/$f"); done
    [[ $d == "$1" || $d == / ]] && break
    d=${d:h}
  done
  for f in $bases; do args+=(-name $f -o); done
  args=($args[1,-2])
  files+=(${(f)"$(command find . -maxdepth 4 \
    \( -name node_modules -o -name .git \) -prune -o \
    -type f \( $args \) -print 2>/dev/null)"})
  (( $#files )) || return 0
  local n
  for n in ${(f)"$(command sed -nE \
      's/^[[:space:]]*(export[[:space:]]+)?([A-Za-z_][A-Za-z0-9_]*)[[:space:]]*=.*/\2/p' \
      $files 2>/dev/null)"}; do
    _skip[$n]=1
  done
}

if [[ $mode == project ]]; then
  top=$(command git rev-parse --show-toplevel 2>/dev/null)
  if [[ -n $top ]]; then
    source "$lib" 2>/dev/null
    if (( $+functions[secret] && $+functions[_secret_resolve_project] )); then
      proj=$(_secret_resolve_project "")
      stage=${SECRET_STAGE:-}
      case $stage in                  # the library's spelling (_secret_canon_stage): one layer, one sentinel
        production)  stage=prod ;;
        development) stage=dev ;;
      esac
      if [[ ${_SECRET_SHIM_PROJ:-} != "$proj@$stage" ]]; then
        prev=${_SECRET_SHIM_PROJ:-}
        [[ -n $prev ]] && _retract
        _release_tool_names
        case $stage in
          prod|production) print -ru2 -- "secret-shim: stage=$stage ($proj)" ;;
        esac
        _scan_dotenv "$top" "$stage"
        _inject
        [[ -n $prev ]] && print -ru2 -- "secret-shim: stage $prev -> $proj@$stage (${#_injected} injected)"
        export _SECRET_SHIM_PROJ="$proj@$stage"
        export _SECRET_SHIM_NAMES="${(j: :)_injected}"
      fi
    fi
  fi
elif [[ $mode == tool ]]; then
  source "$lib" 2>/dev/null
  if (( $+functions[secret] )) && [[ ${_SECRET_SHIM_TOOL:-} != "$name" ]]; then
    # Tool layers are shared only (`--scope <project>`) and stage-less (--no-stage): neither a
    # repository scope nor a stage follows the cwd / shell into a tool, so per-repo scopes and
    # stages can hold what a tool must not see.
    _inject -p "$base" --scope "$base" --no-stage
    [[ $name != "$base" ]] && _inject -p "$name" --scope "$name" --no-stage
    export _SECRET_SHIM_TOOL=$name
    # a project launch underneath may replace these from the repository's
    # layers; a tool under a tool adds to the list, so an outer tool's
    # values stay replaceable too
    _tool_names=(${=_SECRET_SHIM_TOOL_NAMES:-} "${_injected[@]}")
    export _SECRET_SHIM_TOOL_NAMES="${(j: :)${(u)_tool_names}}"
  fi
fi

# A caller that swaps HOME for a temp dir and passes on little more than PATH
# (pytest homes, sandboxes) still lands here first. Left to derive its dirs
# from that HOME, a mise shim behind this launcher sees no installed tool and
# resolves, and installs, every `latest` tool from the network. Pin the dirs
# to the account's home from the user database (zsh sets USERNAME from the
# uid), with zsh/env.zsh's defaults; inherited values win.
_pin_mise_dirs() {
  setopt localoptions no_nomatch
  local h=${~:-"~$USERNAME"}
  [[ $h == /* ]] || return 0
  : ${MISE_DATA_DIR:=$h/.local/share/mise}
  : ${MISE_CONFIG_DIR:=$h/.config/mise}
  : ${MISE_STATE_DIR:=$h/.local/state/mise}
  if [[ $OSTYPE == darwin* ]]; then
    : ${MISE_CACHE_DIR:=$h/Library/Caches/mise}
  else
    : ${MISE_CACHE_DIR:=$h/.cache/mise}
  fi
  export MISE_DATA_DIR MISE_CONFIG_DIR MISE_STATE_DIR MISE_CACHE_DIR
}
_pin_mise_dirs

if [[ $name == opencode && ${1:-} == serve && -z ${OPENCODE_PASSWORD:-}${OPENCODE_SERVER_PASSWORD:-} ]]; then
  print -ru2 -- \
    "secret-shim: OPENCODE_PASSWORD or OPENCODE_SERVER_PASSWORD is required for 'opencode serve' (set it with: secret set OPENCODE_SERVER_PASSWORD -p opencode)"
  exit 1
fi

# Resolve the real binary from PATH, skipping this shim and its sibling
# symlinks by comparing resolved paths.
real=""
for c in ${(f)"$(whence -ap "$name")"}; do
  [[ ${c:A} == "$self" ]] && continue
  real=$c
  break
done
if [[ -z $real ]]; then
  print -ru2 -- "secret-shim: real '$name' not found in PATH"
  exit 127
fi
exec "$real" "$@"
