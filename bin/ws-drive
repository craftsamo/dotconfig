#!/usr/bin/env bash
# ws-drive — the Workspaces Drive mount: Group folders kept in Google Drive behind links
# into an rclone mount at ~/Workspaces/.drive.
#
#   ws-drive setup                 once: Keychain items, encrypted rclone config, Google login
#   ws-drive install               load the LaunchAgent and wait for the mount
#   ws-drive restart [--force]     reload it (refused while a move or restore runs)
#   ws-drive status [--json]       agent, mount, cache, folders on Drive, interrupted work
#   ws-drive links [--check]       link Group assets/ and Drive folders missing here
#   ws-drive move <Tree>/<Group>/<folder>      move a folder to Drive, leave a link
#   ws-drive restore <Tree>/<Group>/<folder>   bring a moved folder back here
#   ws-drive uninstall             unload the LaunchAgent and unmount
#
# The code lives in the Hermes workspace-drive plugin (hermes/plugins/workspace/
# workspace-drive/drive.py) and runs on Hermes' own Python (hermes-python).
# Design: hermes/docs/ops/workspaces-drive.md. Override: WS_DRIVE_CLI.
set -euo pipefail

cli="${WS_DRIVE_CLI:-$HOME/.config/hermes/plugins/workspace/workspace-drive/drive.py}"
if [[ ! -f $cli ]]; then
  echo "ws-drive: cannot find $cli (set WS_DRIVE_CLI)" >&2
  exit 127
fi
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
exec "$here/hermes-python" "$cli" "$@"
