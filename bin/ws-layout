#!/usr/bin/env bash
# ws-layout — the Workspaces layout in force: the root and its areas, read from
# ~/.config/workspaces/layout.json (public defaults when the file is absent).
#
#   ws-layout                 the resolved layout as JSON
#   ws-layout --root          the root only
#   ws-layout --areas         the area names, one a line
#   ws-layout --projects      the area project Groups live in
#   ws-layout --path          the layout file read (or that would be)
#
# The code is shared by the Hermes workspace plugins (hermes/plugins/_shared/
# workspace_layout.py). Contract: hermes/docs/workspace-layout.md.
# Override: WS_LAYOUT_CLI, WORKSPACES_LAYOUT, WORKSPACES_ROOT.
set -euo pipefail

cli="${WS_LAYOUT_CLI:-$HOME/.config/hermes/plugins/_shared/workspace_layout.py}"
if [[ ! -f $cli ]]; then
  echo "ws-layout: cannot find $cli (set WS_LAYOUT_CLI)" >&2
  exit 127
fi
exec python3 "$cli" "$@"
