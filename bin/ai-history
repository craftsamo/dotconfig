#!/usr/bin/env bash
# ai-history — everyday view of AI session history across OpenCode and Hermes.
#
#   ai-history                     today's activity (both tools, overlap removed)
#   ai-history --days 7            the last 7 days
#   ai-history hermes list --today
#   ai-history opencode usage --days 7 --group-by model
#   ai-history --help
#
# The code lives in the Hermes session-history plugin (hermes/plugins/
# session-history/cli.py). It runs on Hermes' own Python so the Hermes reader
# can use Hermes' session store; without it, plain python3 still works and the
# result says it read the databases directly. Read-only: nothing is written.
# Overrides: AI_HISTORY_PYTHON, AI_HISTORY_CLI.
set -euo pipefail

cli="${AI_HISTORY_CLI:-$HOME/.config/hermes/plugins/session-history/cli.py}"
if [[ ! -f $cli ]]; then
  echo "ai-history: cannot find $cli (set AI_HISTORY_CLI)" >&2
  exit 127
fi

py="${AI_HISTORY_PYTHON:-}"
if [[ -z $py ]]; then
  # The real hermes launcher (not the secret shim in this directory) names
  # Hermes' interpreter in its shebang.
  here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
  while IFS= read -r candidate; do
    [[ "$(cd "$(dirname "$candidate")" && pwd -P)" == "$here" ]] && continue
    read -r first < "$candidate" || continue
    interpreter="${first#\#!}"
    interpreter="${interpreter%% *}"
    if [[ $first == '#!'* && $interpreter == */python* && -x $interpreter ]]; then
      py="$interpreter"
      break
    fi
  done < <(type -ap hermes 2>/dev/null || true)
fi
exec "${py:-python3}" "$cli" "$@"
