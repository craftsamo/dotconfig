#!/usr/bin/env bash
# ws-repos — the repositories under ~/Workspaces (<Area>/<Group>/github/<repo>).
#
#   ws-repos                       per-repo local state and open PR/issue counts
#   ws-repos --no-github           local Git state only (no network)
#   ws-repos prs                   open pull requests of writable repos
#   ws-repos issues --group tech   open issues of one Group
#   ws-repos commits --period week your commits of the last 7 days
#   ws-repos prs --period month    PRs updated in 30 days, merged and closed too
#   ws-repos --help
#
# The code lives in the Hermes workspace-repos plugin (hermes/plugins/workspace/
# workspace-repos/repos.py). Read-only: nothing is fetched, committed or pushed.
# Override: WS_REPOS_CLI, WORKSPACES_ROOT.
set -euo pipefail

cli="${WS_REPOS_CLI:-$HOME/.config/hermes/plugins/workspace/workspace-repos/repos.py}"
if [[ ! -f $cli ]]; then
  echo "ws-repos: cannot find $cli (set WS_REPOS_CLI)" >&2
  exit 127
fi
exec python3 "$cli" "$@"
