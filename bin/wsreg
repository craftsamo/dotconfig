#!/usr/bin/env bash
# Thin launcher for the workspace registry CLI (people, projects, memberships,
# repos). The engine is part of the public plugin source; records stay outside
# the repository. Point WSREG_BIN at an alternate engine to override.
set -euo pipefail

script_path="$(realpath "${BASH_SOURCE[0]}")"
config_root="$(cd "$(dirname "$script_path")/.." && pwd -P)"
wsreg_bin="${WSREG_BIN:-${DOTCONFIG:-$config_root}/hermes/plugins/workspace/workspace-registry/wsreg}"

if [[ ! -f $wsreg_bin ]]; then
  echo "wsreg: cannot locate the workspace registry CLI at $wsreg_bin" >&2
  echo "wsreg: install the workspace-registry plugin, or set WSREG_BIN." >&2
  exit 127
fi

exec python3 "$wsreg_bin" "$@"
