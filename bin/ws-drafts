#!/usr/bin/env bash
# ws-drafts — the drafts under ~/Workspaces (every job directory below an .agent/),
# and what waits in ~/Workspaces/.inbox.
#
#   ws-drafts                      per-Group summary (counts, size, stale/misnamed/legacy) + inbox
#   ws-drafts list --stale         drafts nobody touched for 14+ days
#   ws-drafts list --group Acme
#   ws-drafts list --legacy        anything written to the retired layout
#   ws-drafts inbox [--stale]      inbox items, oldest first (stale = waiting 7+ days)
#   ws-drafts --help
#
# The code lives in the Hermes workspace-drafts plugin (hermes/plugins/workspace/
# workspace-drafts/drafts.py). Read-only: nothing is opened, moved or deleted.
# Override: WS_DRAFTS_CLI, WORKSPACES_ROOT.
set -euo pipefail

cli="${WS_DRAFTS_CLI:-$HOME/.config/hermes/plugins/workspace/workspace-drafts/drafts.py}"
if [[ ! -f $cli ]]; then
  echo "ws-drafts: cannot find $cli (set WS_DRAFTS_CLI)" >&2
  exit 127
fi
exec python3 "$cli" "$@"
