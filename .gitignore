# Only tracked top-level directories are linked into ~/.config (install.sh
# "[config]"), so tools that keep their own state there (gh, gcloud, iterm2,
# configstore, ...) never touch this repository and need no entry here. What
# follows is state written INTO a linked directory.
git/credentials
**/*.env
.pytest_cache/

# machine-specific state rewritten by the Codex app (absolute home paths)
codex/config.toml

# Hermes Agent runtime state. ~/.hermes and the profile homes are real
# directories (install.sh "[hermes]"), so Hermes never writes here; these stay
# as a safety net for a HERMES_HOME pointed at this tree by mistake, since
# several hold credentials or private sessions.
hermes/**/auth.json
hermes/**/.env.EXAMPLE
hermes/**/memories/
hermes/**/sessions/
hermes/**/state.db*
hermes/**/logs/
hermes/**/workspace/
hermes/**/plans/
hermes/**/*_cache/
hermes/profiles/*/specialist-sessions/
hermes/profiles/*/resident-sessions/
hermes/profiles/*/opencode-sessions/
hermes/profiles/*/web3-wallet/
hermes/profiles/*/marketing-browser-lease.json
hermes/profiles/*/marketing-browser-lease.guard
# real-profile browsing snapshots (copied cookies / logins) — must never ship
hermes/**/browser-profile/

# Python bytecode: Hermes loads the plugins through links, and Python writes
# bytecode beside the real source
hermes/**/__pycache__/
agents/**/__pycache__/
hermes/**/*.pyc

# Machine-local shell environment. config.zsh already sources every
# ~/.config/zsh/*.zsh; this one is for per-machine settings that belong in no
# repo (private-but-durable shell config goes to private/zsh/ instead).
zsh/local.zsh
