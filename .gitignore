gcloud/
gh/
github-copilot/
iterm2/
configstore/
git/credentials
stripe/
yarn/
**/*.env

# fish is unused here; the Grok Build installer/updater drops completions into it
fish/

# ~/.config/agents/skills is a registered install target of third-party skill
# installers (`hyperframes skills` mirrors into it as the amp/universal agent
# dir) — surrendered to tool droppings and ignored wholesale. The repo-curated
# shared tree lives in agents/curated/ instead; see agents/README.md.
agents/skills/

# opencode's global skill dir is fixed at ~/.config/opencode/skills — inside
# this repo — and it also receives installer droppings (hyperframes mirrors
# its store into every agent dir it recognizes). Allowlist: ignore everything,
# re-include curated entries. A NEW curated skill needs its negation line here
# or it stays silently untracked — check `git status` after adding one.
# (codex/copilot skill dirs are machine-local real dirs, nothing to ignore.)
opencode/skills/*
!opencode/skills/approach/
!opencode/skills/git/
!opencode/skills/manage-github-projects/
!opencode/skills/ux-persona-testing/
!opencode/skills/web-ui/

# machine-specific state rewritten by the Codex app (absolute home paths)
codex/config.toml

# Hermes Agent per-machine state (config/skills/mcp/cron ARE tracked; these are not)
hermes/**/auth.json
hermes/**/.env.EXAMPLE
hermes/**/memories/
hermes/**/sessions/
hermes/**/state.db*
hermes/**/logs/
hermes/**/workspace/
hermes/**/plans/
hermes/**/*_cache/
hermes/**/local/

# Hermes personas: the real SOUL.md is private/local per machine; the tracked
# SOUL.example.md is the bootstrap template (install.sh seeds SOUL.md from it
# when missing, then symlinks it). Personalize SOUL.md locally; it never ships.
hermes/SOUL.md
hermes/**/SOUL.md

# Assistant config holds a private Telegram chat ID (platforms.*.dm_topics);
# keep it local. The tracked config.example.yaml is the bootstrap template.
hermes/profiles/assistant/config.yaml

# Hermes skills: maintainer-owned topology is tracked; adaptive libraries are not.
# At the shared root, default-pipeline/ is the only managed surface — the
# ~/Workspaces data-skill cluster is kept in a separate private checkout and
# reached through skills.external_dirs.
hermes/skills/*
!hermes/skills/default-pipeline/
hermes/skills/learned/

# Workers track one *-pipeline/ plus technic/ leaves. Assistant additionally
# tracks desks/. The skill-topology plugin routes runtime creates to learned/.
hermes/profiles/*/skills/*
!hermes/profiles/*/skills/*-pipeline/
!hermes/profiles/*/skills/technic/
!hermes/profiles/assistant/skills/desks/
hermes/profiles/*/skills/learned/

# Cron entry scripts for work that lives outside this repo. Hermes' scheduler
# only runs a script resolving inside <HERMES_HOME>/scripts, so such a job needs
# a real wrapper here; the owning repo generates it and it stays machine-local.
hermes/profiles/*/scripts/local-*.sh

# Hermes skills bookkeeping: bundled skills (read via skills.external_dirs
# from the agent clone) + curator/hub/usage bookkeeping are never tracked
hermes/**/.bundled_manifest
hermes/**/.usage.json
hermes/**/.usage.json.lock
hermes/**/.curator_state
hermes/**/.curator_suppressed
hermes/**/.curator_backups/
hermes/**/.archive/
hermes/**/.hub/
hermes/**/index-cache/
hermes/**/.restore-backups/

# Hermes plugins: source IS tracked; Python bytecode (written into the symlinked
# plugins dir when Hermes loads a plugin) is not
hermes/**/__pycache__/
agents/**/__pycache__/
hermes/**/*.pyc
# Plugin runtime data written back through the symlinked plugins dir (no source
# here — the hermes-achievements plugin persists badge state + a session-scan
# cache, incl. session titles/timestamps; per-machine, never committed)
hermes/plugins/hermes-achievements/

# Machine-local shell environment. config.zsh already sources every
# ~/.config/zsh/*.zsh; this one is generated (it points at checkouts that live
# outside this repo, e.g. HERMES_PRIVATE_SKILLS) and must stay untracked.
zsh/local.zsh
