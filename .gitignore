gcloud/
gh/
github-copilot/
iterm2/
configstore/
git/credentials
stripe/
yarn/
**/*.env

# fish is unused here; the Grok Build installer/updater drops completions into it
fish/

# app-managed system skills (not user content)
codex/skills/.system/

# HyperFrames-managed skill symlinks: `hyperframes skills update` links its
# store (~/.claude/skills, mirrored via ~/.agents/skills) into harness skill
# dirs; tool-owned, per-machine, never repo content (see hermes/AGENTS.md)
codex/skills/hyperframes*
codex/skills/media-use
copilot/skills/hyperframes*
copilot/skills/media-use
opencode/skills/hyperframes*
opencode/skills/media-use

# Shared cross-agent skill root (~/.agents/skills): NOT tracked by default —
# it doubles as the `npx skills` install target, so third-party skills land
# here. Own skills opt in once via `git add -f <path>` and stay tracked
# thereafter (same policy as hermes/skills below). Third-party ones are
# reinstalled from their source instead; see agents/README.md.
agents/skills/**

# machine-specific state rewritten by the Codex app (absolute home paths)
codex/config.toml

# Hermes Agent per-machine state (config/skills/mcp/cron ARE tracked; these are not)
hermes/**/auth.json
hermes/**/.env.EXAMPLE
hermes/**/memories/
hermes/**/sessions/
hermes/**/state.db*
hermes/**/logs/
hermes/**/workspace/
hermes/**/plans/
hermes/**/*_cache/
hermes/**/local/

# Hermes personas: the real SOUL.md is private/local per machine; the tracked
# SOUL.example.md is the bootstrap template (install.sh seeds SOUL.md from it
# when missing, then symlinks it). Personalize SOUL.md locally; it never ships.
hermes/SOUL.md
hermes/**/SOUL.md

# Assistant config holds a private Telegram chat ID (platforms.*.dm_topics);
# keep it local. The tracked config.example.yaml is the bootstrap template.
hermes/profiles/assistant/config.yaml

# Hermes skills: NOT tracked by default (Hermes authors skills itself).
# Intentional/user-authored skills opt in once via `git add -f <path>`;
# already-tracked skill files are unaffected by these patterns and stay
# tracked, frozen at their committed snapshot via `git update-index
# --skip-worktree` (list: `git ls-files -v | grep ^S`).
hermes/skills/**
hermes/profiles/*/skills/**

# Hermes skills bookkeeping: bundled skills (read via skills.external_dirs
# from the agent clone) + curator/hub/usage bookkeeping are never tracked
hermes/**/.bundled_manifest
hermes/**/.usage.json
hermes/**/.usage.json.lock
hermes/**/.curator_state
hermes/**/.curator_suppressed
hermes/**/.curator_backups/
hermes/**/.archive/
hermes/**/.hub/
hermes/**/index-cache/
hermes/**/.restore-backups/

# Hermes cron: job definitions (cron/jobs.json) ARE tracked; runtime churn is not
hermes/**/cron/output/
hermes/**/cron/.tick.lock
hermes/**/cron/*.lock
hermes/**/cron/ticker_heartbeat
hermes/**/cron/ticker_last_success
hermes/**/cron/executions.db*

# Hermes plugins: source IS tracked; Python bytecode (written into the symlinked
# plugins dir when Hermes loads a plugin) is not
hermes/**/__pycache__/
hermes/**/*.pyc
# Plugin runtime data written back through the symlinked plugins dir (no source
# here — the hermes-achievements plugin persists badge state + a session-scan
# cache, incl. session titles/timestamps; per-machine, never committed)
hermes/plugins/hermes-achievements/
