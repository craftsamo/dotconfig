# web3 engine (plugins/web3/_shared: the reader and the signer of evm-access and solana-access). eth-account signs EVM
# transactions and derives m/44'/60'/0'/0/i (its HD features are flagged unaudited, so tests pin
# known MetaMask vectors); eth-abi decodes calldata and logs; mnemonic is Trezor's BIP39
# reference; solders derives m/44'/501'/i'/0' from the 64-byte seed and signs Solana messages.
# msgpack packs a Hyperliquid action exactly as the venue hashes it before signing (key order kept).
# Recompile the hashed lock after a bump:
#   uv pip compile requirements.in --python ~/.hermes/local/web3/venv/bin/python \
#     --generate-hashes --no-annotate -o requirements.lock
eth-account==0.14.0
eth-abi==6.0.0
mnemonic==0.21
msgpack==1.2.3
solders==0.29.0
