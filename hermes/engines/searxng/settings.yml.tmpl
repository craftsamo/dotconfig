# SearXNG settings for the local Hermes metasearch floor. searxng-launchctl.sh
# renders __SECRET_KEY__ into local/searxng/etc/settings.yml at install; the
# key only signs SearXNG's own cookies and is never shared, so it is generated
# on the host and never tracked.
#
# The instance is loopback-only (the container port is published on
# 127.0.0.1), serves the Hermes web_search cascade over the JSON API, and keeps
# the limiter off: the limiter needs Valkey and would throttle the one agent
# that is its only client.
use_default_settings: true

general:
  instance_name: hermes-searxng
  enable_metrics: false
  debug: false

server:
  secret_key: "__SECRET_KEY__"
  limiter: false
  public_instance: false
  image_proxy: false
  method: GET

search:
  safe_search: 0
  autocomplete: ""
  default_lang: auto
  formats:
    - html
    - json

ui:
  static_use_hash: true

outgoing:
  request_timeout: 6.0
  max_request_timeout: 15.0
