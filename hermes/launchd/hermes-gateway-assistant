#!/bin/sh
# Hermes `assistant` gateway launcher — keychain-pure Telegram + Discord.
#
# Self-contained and machine-agnostic: every path is derived from $HOME, so the
# tracked file has no hardcoded user/home. The LaunchAgent runs THIS script as
# ProgramArguments[0] (not `/bin/sh <script>`), so the login item / process
# reads as "hermes-gateway-assistant" instead of a bare "sh".
#
# Injection: replicates the bin/hermes shim — eval the `global` + `hermes`
# Keychain layers (messaging tokens / model keys / GitHub token / …), then exec
# the REAL hermes (not the shim, which would re-inject). No .env.
set -e

export PATH="$HOME/.config/bin:$HOME/.local/bin:$HOME/.homebrew/bin:$HOME/.homebrew/sbin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

mkdir -p "$HOME/.hermes/logs"
exec >>"$HOME/.hermes/logs/gateway-assistant.log" 2>&1

cd "$HOME/Workspaces" 2>/dev/null || cd "$HOME"

eval "$(secret env -p global)"
eval "$(secret env -p hermes)"

# Bare `deliver: telegram` cron jobs land in the configured system Inbox topic.
# Hermes persists the topic id after creating it; derive it here so private
# chat/thread identifiers stay in the ignored runtime config, not tracked jobs.
ASSISTANT_CONFIG="$HOME/.hermes/profiles/assistant/config.yaml"
unset TELEGRAM_CRON_THREAD_ID
if [ -f "$ASSISTANT_CONFIG" ]; then
  INBOX_THREAD_ID="$({
    awk '
      /^[[:space:]]*- name: Inbox[[:space:]]*$/ { inbox = 1; next }
      inbox && /^[[:space:]]+thread_id:/ { print $2; exit }
      inbox && /^[[:space:]]*- name:/ { exit }
    ' "$ASSISTANT_CONFIG"
  } || true)"
fi
case "${INBOX_THREAD_ID:-}" in
  ''|*[!0-9]*)
    # The first bootstrap must still start so Hermes can create/persist Inbox.
    # A non-numeric explicit target fails before Telegram's stale numeric-topic
    # recovery can retry at root DM. Restart after Inbox receives a thread_id.
    TELEGRAM_CRON_THREAD_ID=disabled
    echo "warning: Inbox thread_id unavailable; Telegram cron delivery is disabled until restart"
    ;;
  *) TELEGRAM_CRON_THREAD_ID="$INBOX_THREAD_ID" ;;
esac
export TELEGRAM_CRON_THREAD_ID
# kanban_comment derives the Assistant's trusted author identity from this value.
export HERMES_PROFILE=assistant

# Real-profile browsing (assistant / marketer) launches a CLONE of the Brave
# bundle, never /Applications/Brave Browser.app itself (LaunchServices would
# treat the headless instance as the everyday browser). Brave auto-updates,
# so refresh the clone before every start; a failure here must not take the
# gateway down — the browser tool fails closed on its own with a clear message.
"$HOME/.config/hermes/scripts/brave-agent-sync.sh" sync || echo "WARN: brave-agent clone sync failed"

exec "$HOME/.local/bin/hermes" -p assistant gateway run --replace --accept-hooks
