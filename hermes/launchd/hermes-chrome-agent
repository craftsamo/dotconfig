#!/bin/sh
# Dedicated automation browser for Hermes' browser tool — headless, isolated profile.
#
# WHY THIS EXISTS
#   Hermes' `browser_exec` runs `browser-use`, which drives a REAL local browser
#   through `browser_harness`. Left to its own discovery, the harness attaches to
#   whichever installed browser has the chrome://inspect remote-debugging toggle
#   set, and every connection then needs a manual "Allow remote debugging?" click.
#   Launching a browser with an EXPLICIT --remote-debugging-port on a NON-DEFAULT
#   user-data-dir skips that consent flow entirely (browser_harness documents this
#   in daemon.py: it "avoids the M144 Allow remote debugging dialog and the M136
#   default-profile lockdown"). Hermes is pointed here with
#   BU_CDP_URL=http://127.0.0.1:9333, injected from the Keychain `hermes` layer.
#
# WHY NOT THE EVERYDAY BROWSER
#   macOS treats one app bundle as ONE running application. A resident instance
#   started from the same bundle as the daily browser makes Dock/Spotlight launches
#   merely activate the resident process, so the daily profile can no longer be
#   opened (this bit us with Brave on 2026-08-17). "Chrome for Testing" is a
#   SEPARATE bundle built for automation, so it collides with neither the everyday
#   Brave nor a normally installed Google Chrome. Real Chrome is only the fallback
#   — if you use Chrome interactively, expect the same activation clash.
#
# KEYCHAIN
#   Chromium encrypts cookies with a key kept in the login keychain ("Chromium Safe
#   Storage"). An automation build is not in that item's ACL, so macOS prompts for
#   the login password — again after every version bump, since the binary path
#   changes. `--use-mock-keychain` makes it derive the key locally instead: no
#   prompts, and sessions still persist because the key is deterministic. The flag
#   MUST match in chrome-agent-launchctl.sh's `login` mode — switching between mock
#   and real keychain makes already-stored cookies undecryptable.
#
# The port and user-data-dir MUST stay in sync with the Keychain BU_CDP_URL value.
set -e

PORT=9333
DATA_DIR="$HOME/.hermes/chrome-agent"

export PATH="/usr/bin:/bin:/usr/sbin:/sbin"

mkdir -p "$HOME/.hermes/logs" "$DATA_DIR"
exec >>"$HOME/.hermes/logs/chrome-agent.log" 2>&1

# Prefer the newest agent-browser-managed "Chrome for Testing" (version-pinned dir
# name, so resolve it dynamically); fall back to a normally installed Chrome.
BROWSER=""
for candidate in $(ls -d "$HOME"/.agent-browser/browsers/chrome-*/ 2>/dev/null | sort -V -r); do
  bin="${candidate}Google Chrome for Testing.app/Contents/MacOS/Google Chrome for Testing"
  if [ -x "$bin" ]; then BROWSER="$bin"; break; fi
done
[ -n "$BROWSER" ] || BROWSER="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
[ -x "$BROWSER" ] || { echo "$(date '+%F %T') no Chrome binary found; install Chrome or run 'agent-browser install'"; exit 1; }

echo "$(date '+%F %T') starting headless $BROWSER on 127.0.0.1:$PORT (profile: $DATA_DIR)"

# --headless=new keeps the process in the foreground so launchd can supervise it.
# The remote-debugging port binds to loopback only.
exec "$BROWSER" \
  --headless=new \
  --remote-debugging-port="$PORT" \
  --user-data-dir="$DATA_DIR" \
  --use-mock-keychain \
  --no-first-run \
  --no-default-browser-check
