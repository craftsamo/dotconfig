<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    TEMPLATE — not loaded directly. `gateway-launchctl.sh install` substitutes
    __HOME__ with $HOME and writes the real plist to ~/Library/LaunchAgents/
    (launchd does not expand ~ / env vars, so the path must be absolute; keeping
    only the template in git avoids committing a machine-specific home path).

    ProgramArguments is the launcher script itself (not `/bin/sh …`) so the
    login item shows "hermes-gateway-multiplex". All runtime setup (PATH, cwd,
    logging, Keychain injection, the supervised-child contract) lives in that script.

    The label starts with `ai.hermes` on purpose: Hermes reads its launchd identity
    from that prefix (drain budget from ExitTimeOut, restart route, control-socket
    supervisor declaration), but it is NOT `ai.hermes.gateway*`, so `hermes gateway
    install/start/update` never regenerates this plist over the Keychain launcher.

    KeepAlive / ThrottleInterval / ExitTimeOut mirror Hermes' own generated plist:
    a clean exit (0) parks the job, exit 75 and crashes relaunch, at most every 30 s;
    60 s is the drain headroom the per-user launchd domain allows before SIGKILL.
  -->
  <key>Label</key>
  <string>ai.hermes.keychain-multiplex</string>

  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.config/hermes/launchd/hermes-gateway-multiplex</string>
  </array>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>ExitTimeOut</key>
  <integer>60</integer>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
