#!/usr/bin/env python3
"""pj — Projects registry engine (SQLite v1, Python stdlib only).

Central registry for ALL Projects groups: project identity, repos, official links, the
team-membership SOURCE OF TRUTH, and flexible tags. The DB is the source of truth at
~/Workspaces/Projects/.registry/projects.db; JSON/CSV under .registry/export/ is a
regenerable mirror. See ../references/data-model.md (the canon); schema.sql is the structure.

Cross-domain reads go through sibling CLIs via _cross (never open another skill's DB):
  * `pj validate` resolves member person_ids through People (`pp`) and reconciles the budget's
    projects through household-budget (`hb`) — read-only, skip-with-warning if absent.
  * People consumes `pj members --json` (the membership mirror it used to read from
    teams/members/*.json). `pj projects --json` / `repos` / `links` are the other read ports.

Project id == the Projects/<id> directory name (e.g. ExampleProject) == the cross-system join key.
"""
from __future__ import annotations

import argparse
import csv
import json
import re
import sqlite3
import sys
import unicodedata
from datetime import datetime, timezone
from pathlib import Path

DEFAULT_ROOT = Path.home() / "Workspaces" / "Projects"
SKILL_DIR = Path(__file__).resolve().parent.parent
SCHEMA_PATH = SKILL_DIR / "schema.sql"
MIGRATIONS_DIR = SKILL_DIR / "migrations"

# shared cross-skill contract/resolver (degrade gracefully if unavailable)
sys.path.insert(0, str(Path(__file__).resolve().parents[2]))  # skills/workspaces/
try:
    import _cross
except Exception:  # pragma: no cover
    _cross = None

SKILL_NAME = "projects"

# base tag axes seeded by `init --seed` (auto-extended on demand)
SEED_AXES = {
    "stage": "Project stage (idea/mvp/launched/paused)",
    "priority": "Attention priority",
    "domain": "Subject domain",
    "engagement": "Member engagement level",
}

# child tables carrying a project_id column (for rename/merge id rewrites)
PROJECT_CHILD_TABLES = [
    "project_aliases", "project_links", "repos", "memberships",
    "membership_roles", "membership_responsibilities", "membership_areas",
    "membership_permission_scopes", "membership_notes", "membership_contacts",
    "project_tags", "membership_tags",
]


# --------------------------------------------------------------------------- helpers
def die(msg: str):
    print(f"pj: {msg}", file=sys.stderr)
    raise SystemExit(1)


def now_iso() -> str:
    return datetime.now(timezone.utc).isoformat()


def today() -> str:
    return datetime.now().strftime("%Y-%m-%d")


def load(path: Path) -> dict:
    return json.loads(Path(path).read_text(encoding="utf-8"))


def normalize_text(s) -> str:
    s = unicodedata.normalize("NFKC", s or "")
    s = s.casefold()
    return re.sub(r"\s+", " ", s).strip()


def slugify(s) -> str:
    """Lower kebab-case slug (example-project)."""
    s = unicodedata.normalize("NFKD", s or "")
    s = s.encode("ascii", "ignore").decode("ascii").casefold()
    s = re.sub(r"[^a-z0-9]+", "-", s).strip("-")
    return s or "unknown"


def db_path(args) -> Path:
    if getattr(args, "db", None):
        return Path(args.db)
    return Path(args.root) / ".registry" / "projects.db"


def connect(args, *, must_exist=True) -> sqlite3.Connection:
    p = db_path(args)
    if must_exist and not p.exists():
        die(f"DB not found: {p}  (run: pj init)")
    con = sqlite3.connect(str(p))
    con.isolation_level = None
    con.row_factory = sqlite3.Row
    con.execute("PRAGMA foreign_keys = ON")
    return con


def _audit(con, action, tbl=None, entity=None, field=None, old=None, new=None, note=None):
    con.execute(
        "INSERT INTO project_audit(ts, action, tbl, entity, field, old_value, new_value, note) "
        "VALUES (?,?,?,?,?,?,?,?)",
        (now_iso(), action, tbl, entity, field,
         None if old is None else str(old), None if new is None else str(new), note))


def _need_project(con, pid):
    if not con.execute("SELECT 1 FROM projects WHERE id = ?", (pid,)).fetchone():
        die(f"no project with id {pid}")


def _need_membership(con, project_id, person_id):
    if not con.execute("SELECT 1 FROM memberships WHERE project_id = ? AND person_id = ?",
                       (project_id, person_id)).fetchone():
        die(f"no membership {person_id} in {project_id}")


def _ensure_axis(con, axis, label=None):
    ax = axis.strip().lower()
    con.execute("INSERT OR IGNORE INTO project_tag_axes(axis, label, review_status) VALUES (?,?, 'confirmed')",
                (ax, label or ax))
    return ax


def _add_alias(con, pid, name, primary=False):
    norm = normalize_text(name)
    if not norm:
        return
    con.execute("INSERT OR IGNORE INTO project_aliases(project_id, alias, alias_norm, is_primary) VALUES (?,?,?,?)",
                (pid, name, norm, 1 if primary else 0))
    if primary:
        con.execute("UPDATE project_aliases SET is_primary = 0 WHERE project_id = ? AND alias_norm != ?", (pid, norm))
        con.execute("UPDATE project_aliases SET is_primary = 1 WHERE project_id = ? AND alias_norm = ?", (pid, norm))


# --------------------------------------------------------------------------- init / migrate
def _seed_base(con):
    for ax, label in SEED_AXES.items():
        con.execute("INSERT OR IGNORE INTO project_tag_axes(axis, label, review_status) VALUES (?,?, 'confirmed')",
                    (ax, label))


def cmd_init(args):
    p = db_path(args)
    if p.exists():
        if not args.force:
            die(f"DB already exists: {p}  (use --force to recreate, or pj migrate to upgrade)")
        p.unlink()
    p.parent.mkdir(parents=True, exist_ok=True)
    con = sqlite3.connect(str(p))
    con.executescript(SCHEMA_PATH.read_text(encoding="utf-8"))
    if args.seed:
        con.execute("PRAGMA foreign_keys = ON")
        _seed_base(con)
    con.commit()
    con.close()
    print(f"initialized {p} (user_version=1)" + (" + seeded base axes" if args.seed else ""))


def _migration_files():
    out = []
    if MIGRATIONS_DIR.exists():
        for f in sorted(MIGRATIONS_DIR.iterdir()):
            m = re.match(r"^(\d+)_.*\.(sql|py)$", f.name)
            if m:
                out.append((int(m.group(1)), f))
    return sorted(out)


def cmd_migrate(args):
    import importlib.util
    con = connect(args)
    cur = con.execute("PRAGMA user_version").fetchone()[0]
    pending = [(v, f) for v, f in _migration_files() if v > cur]
    if not pending:
        print(f"up to date (user_version={cur})")
        return
    for v, f in pending:
        if args.dry_run:
            print(f"would apply {f.name} -> user_version={v}")
            continue
        if f.suffix == ".sql":
            body = f.read_text(encoding="utf-8")
            try:
                con.executescript(f"BEGIN;\n{body}\nPRAGMA user_version = {v};\nCOMMIT;")
            except Exception:
                try:
                    con.execute("ROLLBACK")
                except Exception:
                    pass
                raise
        else:
            con.execute("BEGIN")
            con.execute("PRAGMA defer_foreign_keys = ON")
            try:
                spec = importlib.util.spec_from_file_location(f.stem, f)
                mod = importlib.util.module_from_spec(spec)
                spec.loader.exec_module(mod)
                mod.up(con)
                bad = con.execute("PRAGMA foreign_key_check").fetchall()
                if bad:
                    raise RuntimeError(f"foreign_key_check failed after {f.name}: {bad}")
                con.execute(f"PRAGMA user_version = {v}")
                con.execute("COMMIT")
            except Exception:
                con.execute("ROLLBACK")
                raise
        print(f"applied {f.name} -> user_version={v}")


# --------------------------------------------------------------------------- membership read shape
def _membership_obj(con, project_id, person_id):
    m = con.execute("SELECT * FROM memberships WHERE project_id = ? AND person_id = ?",
                    (project_id, person_id)).fetchone()
    if not m:
        return None
    return {
        "person_id": person_id, "project_id": project_id,
        "status": m["status"], "working_relationship": m["working_relationship"],
        "roles": [r[0] for r in con.execute("SELECT role FROM membership_roles WHERE project_id=? AND person_id=? ORDER BY role", (project_id, person_id))],
        "responsibilities": [r[0] for r in con.execute("SELECT responsibility FROM membership_responsibilities WHERE project_id=? AND person_id=? ORDER BY responsibility", (project_id, person_id))],
        "areas": [r[0] for r in con.execute("SELECT area FROM membership_areas WHERE project_id=? AND person_id=? ORDER BY area", (project_id, person_id))],
        "permissions": {
            "can_approve": [r[0] for r in con.execute("SELECT target FROM membership_permission_scopes WHERE project_id=? AND person_id=? AND action='approve' ORDER BY target", (project_id, person_id))],
            "can_review": [r[0] for r in con.execute("SELECT target FROM membership_permission_scopes WHERE project_id=? AND person_id=? AND action='review' ORDER BY target", (project_id, person_id))],
            "can_merge": bool(m["can_merge"]), "can_deploy": bool(m["can_deploy"]),
        },
        "project_contacts": {r["channel"]: r["handle"] for r in con.execute("SELECT channel, handle FROM membership_contacts WHERE project_id=? AND person_id=?", (project_id, person_id))},
        "notes": [r[0] for r in con.execute("SELECT text FROM membership_notes WHERE project_id=? AND person_id=? ORDER BY seq", (project_id, person_id))],
        "tags": [{"axis": r["axis"], "value": r["value"]} for r in con.execute("SELECT axis, value FROM membership_tags WHERE project_id=? AND person_id=? ORDER BY axis, value", (project_id, person_id))],
        "last_updated": m["last_updated"],
    }


def _all_memberships(con, project_id=None):
    out = []
    if project_id:
        rows = con.execute("SELECT project_id, person_id FROM memberships WHERE project_id = ? ORDER BY person_id", (project_id,))
    else:
        rows = con.execute("SELECT project_id, person_id FROM memberships ORDER BY project_id, person_id")
    for r in rows.fetchall():
        out.append(_membership_obj(con, r["project_id"], r["person_id"]))
    return out


def _project_obj(con, pid, *, full=True):
    p = con.execute("SELECT * FROM projects WHERE id = ?", (pid,)).fetchone()
    if not p:
        return None
    obj = {
        "id": p["id"], "slug": p["slug"], "canonical_name": p["canonical_name"],
        "kind": p["kind"], "status": p["status"], "dir_path": p["dir_path"],
        "summary": p["summary"], "review_status": p["review_status"],
        "last_updated": p["last_updated"], "created_at": p["created_at"], "updated_at": p["updated_at"],
        "aliases": [{"alias": r["alias"], "is_primary": bool(r["is_primary"])} for r in
                    con.execute("SELECT alias, is_primary FROM project_aliases WHERE project_id = ? ORDER BY is_primary DESC, alias", (pid,))],
        "links": [{"kind": r["kind"], "url": r["url"], "label": r["label"]} for r in
                  con.execute("SELECT kind, url, label FROM project_links WHERE project_id = ? ORDER BY kind, url", (pid,))],
        "tags": [{"axis": r["axis"], "value": r["value"]} for r in
                 con.execute("SELECT axis, value FROM project_tags WHERE project_id = ? ORDER BY axis, value", (pid,))],
    }
    if full:
        obj["repos"] = [_repo_obj(r) for r in
                        con.execute("SELECT * FROM repos WHERE project_id = ? ORDER BY name", (pid,))]
        obj["members"] = _all_memberships(con, pid)
    return obj


def _repo_obj(r):
    return {
        "name": r["name"], "owner": r["owner"], "host": r["host"], "url": r["url"],
        "ghq_path": r["ghq_path"], "link_path": r["link_path"],
        "has_agents_md": bool(r["has_agents_md"]), "summary": r["summary"],
        "status": r["status"], "review_status": r["review_status"],
    }


# --------------------------------------------------------------------------- read ports
def _emit(data):
    if _cross is not None:
        _cross.emit(SKILL_NAME, data)
    else:  # fallback envelope if shared module is unavailable
        print(json.dumps({"contract_version": 1, "skill": SKILL_NAME, "data": data},
                         ensure_ascii=False, indent=2))


def cmd_show(args):
    con = connect(args)
    obj = _project_obj(con, args.id)
    if not obj:
        die(f"no project with id {args.id}")
    if args.json:
        _emit(obj)
    else:
        print(json.dumps(obj, ensure_ascii=False, indent=2))


def cmd_list(args):
    con = connect(args)
    q = "SELECT id, slug, canonical_name, kind, status, review_status, dir_path FROM projects WHERE 1=1"
    params = []
    if args.status:
        q += " AND status = ?"; params.append(args.status)
    if args.kind:
        q += " AND kind = ?"; params.append(args.kind)
    q += " ORDER BY id"
    rows = con.execute(q, params).fetchall()
    if args.json:
        _emit({"projects": [dict(r) for r in rows]})
        return
    for r in rows:
        print(f"  {r['id']:<16} {r['kind']:<9} {r['status']:<9} {r['review_status']:<12} {r['canonical_name']}")
    print(f"{len(rows)} project(s)")


def cmd_projects(args):
    """Cross read-port: project identity + aliases (for budget/People reconciliation)."""
    con = connect(args)
    data = {"projects": [_project_obj(con, r["id"], full=False)
                         for r in con.execute("SELECT id FROM projects ORDER BY id")]}
    if args.json:
        _emit(data)
    else:
        print(json.dumps(data, ensure_ascii=False, indent=2))


def cmd_members(args):
    """Cross read-port: memberships in People-mirror shape (People consumes this)."""
    con = connect(args)
    data = {"memberships": _all_memberships(con, getattr(args, "project", None))}
    if args.json:
        _emit(data)
    else:
        print(json.dumps(data, ensure_ascii=False, indent=2))


def cmd_repos(args):
    con = connect(args)
    if getattr(args, "project", None):
        rows = con.execute("SELECT * FROM repos WHERE project_id = ? ORDER BY name", (args.project,)).fetchall()
    else:
        rows = con.execute("SELECT * FROM repos ORDER BY project_id, name").fetchall()
    if args.json:
        _emit({"repos": [{"project_id": r["project_id"], **_repo_obj(r)} for r in rows]})
        return
    for r in rows:
        print(f"  {r['project_id']:<16} {r['name']:<16} {r['status']:<10} {r['url'] or ''}")
    print(f"{len(rows)} repo(s)")


def cmd_links(args):
    con = connect(args)
    if getattr(args, "project", None):
        rows = con.execute("SELECT * FROM project_links WHERE project_id = ? ORDER BY kind, url", (args.project,)).fetchall()
    else:
        rows = con.execute("SELECT * FROM project_links ORDER BY project_id, kind, url").fetchall()
    if args.json:
        _emit({"links": [{"project_id": r["project_id"], "kind": r["kind"], "url": r["url"], "label": r["label"]} for r in rows]})
        return
    for r in rows:
        print(f"  {r['project_id']:<16} {r['kind']:<9} {r['url']}")
    print(f"{len(rows)} link(s)")


def cmd_report(args):
    con = connect(args)
    ax = args.by.strip().lower()
    scope = args.scope
    print(f"axis: {ax}  (scope: {scope})")
    if scope in ("project", "both"):
        rows = con.execute(
            "SELECT value, COUNT(*) n, GROUP_CONCAT(project_id, ', ') ids FROM project_tags "
            "WHERE axis = ? GROUP BY value_norm ORDER BY value", (ax,)).fetchall()
        print("  projects:")
        for r in rows:
            print(f"    {r['value']:<16} {r['n']:>3}  [{r['ids']}]")
        if not rows:
            print("    (none)")
    if scope in ("member", "both"):
        rows = con.execute(
            "SELECT value, COUNT(*) n FROM membership_tags WHERE axis = ? GROUP BY value_norm ORDER BY value", (ax,)).fetchall()
        print("  members:")
        for r in rows:
            print(f"    {r['value']:<16} {r['n']:>3}")
        if not rows:
            print("    (none)")


# --------------------------------------------------------------------------- project mutators
def cmd_upsert_project(args):
    con = connect(args)
    pid = args.id
    exists = con.execute("SELECT * FROM projects WHERE id = ?", (pid,)).fetchone()
    now = now_iso()
    dir_path = None
    if args.external:
        dir_path = None
    elif args.dir_path is not None:
        dir_path = args.dir_path or None
    elif not exists:
        guess = Path(args.root) / pid
        dir_path = str(guess) if guess.exists() else None
    con.execute("BEGIN")
    try:
        if exists:
            fields = {}
            if args.name is not None:
                fields["canonical_name"] = args.name
            if args.slug:
                fields["slug"] = slugify(args.slug)
            if args.kind:
                fields["kind"] = args.kind
            if args.status:
                fields["status"] = args.status
            if args.review_status:
                fields["review_status"] = args.review_status
            if args.summary is not None:
                fields["summary"] = args.summary or None
            if args.external or args.dir_path is not None:
                fields["dir_path"] = dir_path
            fields["updated_at"] = now
            fields["last_updated"] = args.last_updated or today()
            sets = ", ".join(f"{k} = ?" for k in fields)
            con.execute(f"UPDATE projects SET {sets} WHERE id = ?", (*fields.values(), pid))
            for k, v in fields.items():
                if k not in ("updated_at", "last_updated"):
                    _audit(con, "update", "projects", pid, k, None, v)
            action = "updated"
        else:
            con.execute(
                "INSERT INTO projects(id, slug, canonical_name, kind, status, dir_path, summary, "
                "review_status, last_updated, created_at, updated_at) VALUES (?,?,?,?,?,?,?,?,?,?,?)",
                (pid, slugify(args.slug or pid), args.name or pid, args.kind or ("external" if args.external else "category"),
                 args.status or "active", dir_path, args.summary,
                 args.review_status or "needs_review", args.last_updated or today(), now, now))
            _audit(con, "create", "projects", pid, None, None, pid)
            action = "created"
        _add_alias(con, pid, args.name or pid, primary=True)
        _add_alias(con, pid, pid, primary=False)
        for a in (args.alias or []):
            _add_alias(con, pid, a, primary=False)
        con.execute("COMMIT")
    except Exception:
        con.execute("ROLLBACK")
        raise
    print(json.dumps({"action": action, "id": pid}, ensure_ascii=False))


def cmd_set_status(args):
    con = connect(args)
    _need_project(con, args.id)
    con.execute("UPDATE projects SET status = ?, updated_at = ?, last_updated = ? WHERE id = ?",
                (args.status, now_iso(), today(), args.id))
    _audit(con, "set-status", "projects", args.id, "status", None, args.status)
    print(json.dumps({"action": "set-status", "id": args.id, "status": args.status}, ensure_ascii=False))


def _set_review(args, value):
    con = connect(args)
    _need_project(con, args.id)
    con.execute("UPDATE projects SET review_status = ?, updated_at = ? WHERE id = ?", (value, now_iso(), args.id))
    _audit(con, "review", "projects", args.id, "review_status", None, value)
    print(json.dumps({"action": value, "id": args.id}, ensure_ascii=False))


def cmd_confirm(args):
    _set_review(args, "confirmed")


def cmd_ignore(args):
    _set_review(args, "ignored")


def cmd_review(args):
    con = connect(args)
    print("projects pending review:")
    n = 0
    for r in con.execute("SELECT id, canonical_name FROM projects WHERE review_status = 'needs_review' ORDER BY id"):
        print(f"  project  {r['id']:<16} {r['canonical_name']}"); n += 1
    for r in con.execute("SELECT project_id, name FROM repos WHERE review_status = 'needs_review' ORDER BY project_id, name"):
        print(f"  repo     {r['project_id']}/{r['name']}"); n += 1
    if not n:
        print("  (nothing pending)")


def cmd_rename_project(args):
    con = connect(args)
    _need_project(con, args.old)
    if con.execute("SELECT 1 FROM projects WHERE id = ?", (args.new,)).fetchone():
        die(f"target id {args.new} already exists (use merge-project)")
    con.execute("BEGIN")
    con.execute("PRAGMA defer_foreign_keys = ON")
    try:
        con.execute("UPDATE projects SET id = ?, updated_at = ? WHERE id = ?", (args.new, now_iso(), args.old))
        for tbl in PROJECT_CHILD_TABLES:
            con.execute(f"UPDATE {tbl} SET project_id = ? WHERE project_id = ?", (args.new, args.old))
        con.execute("UPDATE project_audit SET entity = ? WHERE entity = ?", (args.new, args.old))
        bad = con.execute("PRAGMA foreign_key_check").fetchall()
        if bad:
            raise RuntimeError(f"foreign_key_check failed: {bad}")
        _audit(con, "rename", "projects", args.new, "id", args.old, args.new,
               note="re-run People import + budget reconcile (join key changed)")
        con.execute("COMMIT")
    except Exception:
        con.execute("ROLLBACK")
        raise
    print(json.dumps({"action": "renamed", "from": args.old, "to": args.new,
                      "note": "join key changed: re-sync People + budget"}, ensure_ascii=False))


def cmd_merge_project(args):
    con = connect(args)
    _need_project(con, args.old)
    _need_project(con, args.into)
    if args.old == args.into:
        die("old and into are the same")
    con.execute("BEGIN")
    con.execute("PRAGMA defer_foreign_keys = ON")
    try:
        for tbl in PROJECT_CHILD_TABLES:
            con.execute(f"UPDATE OR IGNORE {tbl} SET project_id = ? WHERE project_id = ?", (args.into, args.old))
            con.execute(f"DELETE FROM {tbl} WHERE project_id = ?", (args.old,))
        con.execute("DELETE FROM projects WHERE id = ?", (args.old,))
        bad = con.execute("PRAGMA foreign_key_check").fetchall()
        if bad:
            raise RuntimeError(f"foreign_key_check failed: {bad}")
        _audit(con, "merge", "projects", args.into, "id", args.old, args.into)
        con.execute("COMMIT")
    except Exception:
        con.execute("ROLLBACK")
        raise
    print(json.dumps({"action": "merged", "from": args.old, "into": args.into}, ensure_ascii=False))


# --------------------------------------------------------------------------- project facets
def cmd_alias_add(args):
    con = connect(args)
    _need_project(con, args.id)
    con.execute("BEGIN")
    try:
        _add_alias(con, args.id, args.alias, primary=args.primary)
        _audit(con, "alias", "project_aliases", args.id, None, None, args.alias)
        con.execute("COMMIT")
    except Exception:
        con.execute("ROLLBACK"); raise
    print(json.dumps({"action": "alias-add", "id": args.id, "alias": args.alias}, ensure_ascii=False))


def cmd_alias_rm(args):
    con = connect(args)
    con.execute("DELETE FROM project_aliases WHERE project_id = ? AND alias_norm = ?", (args.id, normalize_text(args.alias)))
    if con.total_changes == 0:
        die(f"no alias {args.alias!r} for {args.id}")
    _audit(con, "alias-rm", "project_aliases", args.id, None, args.alias, None)
    print(json.dumps({"action": "alias-rm", "id": args.id, "alias": args.alias}, ensure_ascii=False))


def cmd_link_set(args):
    con = connect(args)
    _need_project(con, args.id)
    con.execute("BEGIN")
    try:
        con.execute("INSERT OR REPLACE INTO project_links(project_id, kind, url, label) VALUES (?,?,?,?)",
                    (args.id, args.kind, args.url, args.label))
        _audit(con, "link", "project_links", args.id, args.kind, None, args.url)
        con.execute("COMMIT")
    except Exception:
        con.execute("ROLLBACK"); raise
    print(json.dumps({"action": "link-set", "id": args.id, "kind": args.kind, "url": args.url}, ensure_ascii=False))


def cmd_link_rm(args):
    con = connect(args)
    con.execute("DELETE FROM project_links WHERE project_id = ? AND kind = ? AND url = ?", (args.id, args.kind, args.url))
    if con.total_changes == 0:
        die(f"no {args.kind} link {args.url!r} for {args.id}")
    _audit(con, "link-rm", "project_links", args.id, args.kind, args.url, None)
    print(json.dumps({"action": "link-rm", "id": args.id, "kind": args.kind, "url": args.url}, ensure_ascii=False))


def cmd_tag_set(args):
