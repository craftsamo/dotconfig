# --------------------------------------------------------------------------- repos
def cmd_repo_set(args):
    con = connect(args)
    _need_project(con, args.project)
    exists = con.execute("SELECT 1 FROM repos WHERE project_id = ? AND name = ?", (args.project, args.name)).fetchone()
    con.execute("BEGIN")
    try:
        if exists:
            fields = {}
            for k, v in (("owner", args.owner), ("host", args.host), ("url", args.url),
                         ("ghq_path", args.ghq_path), ("link_path", args.link_path),
                         ("summary", args.summary), ("status", args.status)):
                if v is not None:
                    fields[k] = v or None
            if args.has_agents_md is not None:
                fields["has_agents_md"] = 1 if args.has_agents_md else 0
            if args.review_status:
                fields["review_status"] = args.review_status
            if fields:
                sets = ", ".join(f"{k} = ?" for k in fields)
                con.execute(f"UPDATE repos SET {sets} WHERE project_id = ? AND name = ?", (*fields.values(), args.project, args.name))
            action = "updated"
        else:
            host = args.host or "github.com"
            url = args.url or (f"https://{host}/{args.owner}/{args.name}" if args.owner else None)
            con.execute(
                "INSERT INTO repos(project_id, name, owner, host, url, ghq_path, link_path, has_agents_md, "
                "summary, status, review_status) VALUES (?,?,?,?,?,?,?,?,?,?,?)",
                (args.project, args.name, args.owner, host, url, args.ghq_path, args.link_path,
                 1 if args.has_agents_md else 0, args.summary, args.status or "declared",
                 args.review_status or "needs_review"))
            action = "created"
        _audit(con, "repo", "repos", f"{args.project}/{args.name}", None, None, action)
        con.execute("COMMIT")
    except Exception:
        con.execute("ROLLBACK"); raise
    print(json.dumps({"action": f"repo-{action}", "project": args.project, "name": args.name}, ensure_ascii=False))


def cmd_repo_rm(args):
    con = connect(args)
    con.execute("DELETE FROM repos WHERE project_id = ? AND name = ?", (args.project, args.name))
    if con.total_changes == 0:
        die(f"no repo {args.name!r} in {args.project}")
    _audit(con, "repo-rm", "repos", f"{args.project}/{args.name}", None, args.name, None)
    print(json.dumps({"action": "repo-rm", "project": args.project, "name": args.name}, ensure_ascii=False))


def cmd_link_repo(args):
    """Materialize the github/<name> symlink to a ghq clone (clone itself is opt-in/manual)."""
    con = connect(args)
    r = con.execute("SELECT * FROM repos WHERE project_id = ? AND name = ?", (args.project, args.name)).fetchone()
    if not r:
        die(f"no repo {args.name!r} in {args.project}")
    proj = con.execute("SELECT dir_path FROM projects WHERE id = ?", (args.project,)).fetchone()
    if not proj or not proj["dir_path"]:
        die(f"project {args.project} has no dir_path; cannot place a symlink")
    ghq = r["ghq_path"]
    if not ghq:
        host, owner = r["host"] or "github.com", r["owner"]
        ghq = str(Path.home() / "ghq" / host / (owner or "") / args.name) if owner else None
    link_path = r["link_path"] or str(Path(proj["dir_path"]) / "github" / args.name)
    status = r["status"]
    note = None
    if ghq and Path(ghq).exists():
        lp = Path(link_path)
        lp.parent.mkdir(parents=True, exist_ok=True)
        if lp.is_symlink() or lp.exists():
            if lp.is_symlink() and str(lp.resolve()) == str(Path(ghq).resolve()):
                note = "symlink already correct"
            else:
                die(f"{lp} already exists and is not the expected symlink")
        else:
            lp.symlink_to(ghq)
            note = f"linked {lp} -> {ghq}"
        status = "linked"
    else:
        status = "missing"
        note = f"clone not found at {ghq or '(unknown ghq path)'}; declared only (clone manually, then re-run)"
    con.execute("BEGIN")
    try:
        con.execute("UPDATE repos SET ghq_path = ?, link_path = ?, status = ? WHERE project_id = ? AND name = ?",
                    (ghq, link_path, status, args.project, args.name))
        _audit(con, "link-repo", "repos", f"{args.project}/{args.name}", "status", None, status, note=note)
        con.execute("COMMIT")
    except Exception:
        con.execute("ROLLBACK"); raise
    print(json.dumps({"action": "link-repo", "project": args.project, "name": args.name,
                      "status": status, "note": note}, ensure_ascii=False))


# --------------------------------------------------------------------------- members
def _upsert_membership_row(con, project_id, person_id, args, now):
    exists = con.execute("SELECT 1 FROM memberships WHERE project_id = ? AND person_id = ?", (project_id, person_id)).fetchone()
    if exists:
        fields = {}
        if args.status is not None:
            fields["status"] = args.status or None
        if args.working_relationship is not None:
            fields["working_relationship"] = args.working_relationship or None
        if args.can_merge is not None:
            fields["can_merge"] = 1 if args.can_merge else 0
        if args.can_deploy is not None:
            fields["can_deploy"] = 1 if args.can_deploy else 0
        fields["updated_at"] = now
        fields["last_updated"] = args.last_updated or today()
        sets = ", ".join(f"{k} = ?" for k in fields)
        con.execute(f"UPDATE memberships SET {sets} WHERE project_id = ? AND person_id = ?", (*fields.values(), project_id, person_id))
        return "updated"
    con.execute(
        "INSERT INTO memberships(project_id, person_id, status, working_relationship, can_merge, can_deploy, "
        "last_updated, created_at, updated_at) VALUES (?,?,?,?,?,?,?,?,?)",
        (project_id, person_id, args.status if args.status is not None else "active", args.working_relationship,
         1 if args.can_merge else 0, 1 if args.can_deploy else 0, args.last_updated or today(), now, now))
    return "created"


def cmd_member_set(args):
    con = connect(args)
    _need_project(con, args.project)
    now = now_iso()
    con.execute("BEGIN")
    try:
        action = _upsert_membership_row(con, args.project, args.person, args, now)
        for role in (args.role or []):
            con.execute("INSERT OR IGNORE INTO membership_roles VALUES (?,?,?)", (args.project, args.person, role))
        for r in (args.responsibility or []):
            con.execute("INSERT OR IGNORE INTO membership_responsibilities VALUES (?,?,?)", (args.project, args.person, r))
        for a in (args.area or []):
            con.execute("INSERT OR IGNORE INTO membership_areas VALUES (?,?,?)", (args.project, args.person, a))
        for t in (args.approve or []):
            con.execute("INSERT OR IGNORE INTO membership_permission_scopes VALUES (?,?,?,?)", (args.project, args.person, "approve", t))
        for t in (args.review or []):
            con.execute("INSERT OR IGNORE INTO membership_permission_scopes VALUES (?,?,?,?)", (args.project, args.person, "review", t))
        for note in (args.note or []):
            nxt = con.execute("SELECT COALESCE(MAX(seq),0)+1 FROM membership_notes WHERE project_id=? AND person_id=?", (args.project, args.person)).fetchone()[0]
            con.execute("INSERT INTO membership_notes VALUES (?,?,?,?)", (args.project, args.person, nxt, note))
        for kv in (args.contact or []):
            if "=" not in kv:
                die(f"--contact must be channel=handle, got {kv!r}")
            ch, h = kv.split("=", 1)
            con.execute("INSERT OR REPLACE INTO membership_contacts VALUES (?,?,?,?)", (args.project, args.person, ch.strip().lower(), h))
        _audit(con, "member", "memberships", f"{args.project}/{args.person}", None, None, action)
        con.execute("COMMIT")
    except Exception:
        con.execute("ROLLBACK"); raise
    print(json.dumps({"action": f"member-{action}", "project": args.project, "person": args.person}, ensure_ascii=False))


def cmd_member_rm(args):
    con = connect(args)
    con.execute("DELETE FROM memberships WHERE project_id = ? AND person_id = ?", (args.project, args.person))
    if con.total_changes == 0:
        die(f"no membership {args.person} in {args.project}")
    _audit(con, "member-rm", "memberships", f"{args.project}/{args.person}", None, args.person, None)
    print(json.dumps({"action": "member-rm", "project": args.project, "person": args.person}, ensure_ascii=False))


