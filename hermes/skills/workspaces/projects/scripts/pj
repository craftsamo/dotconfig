# --------------------------------------------------------------------------- import-legacy
def _import_member_dict(con, project_id, person_id, m, now):
    perms = m.get("permissions") or {}
    con.execute(
        "INSERT OR REPLACE INTO memberships(project_id, person_id, status, working_relationship, can_merge, "
        "can_deploy, last_updated, created_at, updated_at) VALUES (?,?,?,?,?,?,?,?,?)",
        (project_id, person_id, m.get("status"), m.get("working_relationship"),
         1 if perms.get("can_merge") else 0, 1 if perms.get("can_deploy") else 0,
         m.get("last_updated"), now, now))
    for role in m.get("roles") or []:
        con.execute("INSERT OR IGNORE INTO membership_roles VALUES (?,?,?)", (project_id, person_id, role))
    for r in m.get("responsibilities") or []:
        con.execute("INSERT OR IGNORE INTO membership_responsibilities VALUES (?,?,?)", (project_id, person_id, r))
    for a in m.get("areas") or []:
        con.execute("INSERT OR IGNORE INTO membership_areas VALUES (?,?,?)", (project_id, person_id, a))
    for t in perms.get("can_approve") or []:
        con.execute("INSERT OR IGNORE INTO membership_permission_scopes VALUES (?,?,?,?)", (project_id, person_id, "approve", t))
    for t in perms.get("can_review") or []:
        con.execute("INSERT OR IGNORE INTO membership_permission_scopes VALUES (?,?,?,?)", (project_id, person_id, "review", t))
    for i, note in enumerate(m.get("notes") or [], start=1):
        con.execute("INSERT OR IGNORE INTO membership_notes VALUES (?,?,?,?)", (project_id, person_id, i, note))
    for ch, h in (m.get("project_contacts") or {}).items():
        con.execute("INSERT OR IGNORE INTO membership_contacts VALUES (?,?,?,?)", (project_id, person_id, ch, h))


def cmd_import_legacy(args):
    """Build projects + memberships from legacy group dirs (Projects/*/teams/members/*.json)."""
    src = Path(args.src) if args.src else Path(args.root)
    con = connect(args)
    now = now_iso()
    projects, members = 0, 0
    con.execute("BEGIN")
    try:
        for d in sorted(src.iterdir()):
            if not d.is_dir() or d.name.startswith("."):
                continue
            mdir = d / "teams" / "members"
            if not mdir.is_dir() and not (d / "AGENTS.md").exists():
                continue
            pid = d.name
            real = (Path(args.root) / pid)
            dir_path = str(real) if real.exists() else str(d)
            if not con.execute("SELECT 1 FROM projects WHERE id = ?", (pid,)).fetchone():
                con.execute(
                    "INSERT INTO projects(id, slug, canonical_name, kind, status, dir_path, summary, "
                    "review_status, last_updated, created_at, updated_at) VALUES (?,?,?,?,?,?,?,?,?,?,?)",
                    (pid, slugify(pid), pid, "category", "active", dir_path, None, "needs_review", today(), now, now))
                _add_alias(con, pid, pid, primary=True)
                projects += 1
            if mdir.is_dir():
                for f in sorted(mdir.glob("*.json")):
                    m = load(f)
                    person_id = m.get("person_id") or f.stem
                    _import_member_dict(con, pid, person_id, m, now)
                    members += 1
        _audit(con, "import-legacy", None, None, None, None, f"{projects} projects, {members} memberships from {src}")
        con.execute("COMMIT")
    except Exception:
        con.execute("ROLLBACK")
        raise
    print(json.dumps({"action": "import-legacy", "projects": projects, "memberships": members, "src": str(src)}, ensure_ascii=False))


# --------------------------------------------------------------------------- import-json (from mirror)
def cmd_import_json(args):
    src = Path(args.src) if args.src else Path(args.root) / ".registry" / "export"
    con = connect(args)
    n = con.execute("SELECT COUNT(*) FROM projects").fetchone()[0]
    if n and not args.force:
        die(f"DB already has {n} project(s) (use --force to re-import into an empty DB)")
    pf = src / "entities" / "projects.json"
    if not pf.exists():
        die(f"no mirror at {pf}")
    now = now_iso()
    proj_c = mem_c = 0
    con.execute("BEGIN")
    try:
        for p in load(pf)["projects"]:
            con.execute(
                "INSERT OR REPLACE INTO projects(id, slug, canonical_name, kind, status, dir_path, summary, "
                "review_status, last_updated, created_at, updated_at) VALUES (?,?,?,?,?,?,?,?,?,?,?)",
                (p["id"], p.get("slug") or slugify(p["id"]), p.get("canonical_name", p["id"]), p.get("kind", "category"),
                 p.get("status", "active"), p.get("dir_path"), p.get("summary"), p.get("review_status", "confirmed"),
                 p.get("last_updated"), p.get("created_at") or now, p.get("updated_at") or now))
            for a in p.get("aliases", []):
                con.execute("INSERT OR IGNORE INTO project_aliases(project_id, alias, alias_norm, is_primary) VALUES (?,?,?,?)",
                            (p["id"], a["alias"], normalize_text(a["alias"]), int(a.get("is_primary", 0))))
            for l in p.get("links", []):
                con.execute("INSERT OR IGNORE INTO project_links(project_id, kind, url, label) VALUES (?,?,?,?)",
                            (p["id"], l["kind"], l["url"], l.get("label")))
            for t in p.get("tags", []):
                _ensure_axis(con, t["axis"])
                con.execute("INSERT OR IGNORE INTO project_tags(project_id, axis, value, value_norm) VALUES (?,?,?,?)",
                            (p["id"], t["axis"], t["value"], normalize_text(t["value"])))
            for r in p.get("repos", []):
                con.execute(
                    "INSERT OR REPLACE INTO repos(project_id, name, owner, host, url, ghq_path, link_path, "
                    "has_agents_md, summary, status, review_status) VALUES (?,?,?,?,?,?,?,?,?,?,?)",
                    (p["id"], r["name"], r.get("owner"), r.get("host", "github.com"), r.get("url"), r.get("ghq_path"),
                     r.get("link_path"), 1 if r.get("has_agents_md") else 0, r.get("summary"),
                     r.get("status", "declared"), r.get("review_status", "confirmed")))
            proj_c += 1
        mf = src / "entities" / "memberships.json"
        if mf.exists():
            for m in load(mf)["memberships"]:
                _import_member_dict(con, m["project_id"], m["person_id"], m, now)
                for t in m.get("tags", []):
                    _ensure_axis(con, t["axis"])
                    con.execute("INSERT OR IGNORE INTO membership_tags(project_id, person_id, axis, value, value_norm) VALUES (?,?,?,?,?)",
                                (m["project_id"], m["person_id"], t["axis"], t["value"], normalize_text(t["value"])))
                mem_c += 1
        _audit(con, "import-json", None, None, None, None, f"{proj_c} projects, {mem_c} memberships from {src}")
        con.execute("COMMIT")
    except Exception:
        con.execute("ROLLBACK")
        raise
    print(json.dumps({"action": "import-json", "projects": proj_c, "memberships": mem_c, "src": str(src)}, ensure_ascii=False))


# --------------------------------------------------------------------------- export
def cmd_export(args):
    con = connect(args)
    out = Path(args.out) if args.out else Path(args.root) / ".registry" / "export"
    if args.format in ("json", "both"):
        _export_json(con, out)
    if args.format in ("csv", "both"):
        _export_csv(con, out / "csv" if args.format == "both" else out)
    print(f"exported {args.format} -> {out}")


def _export_json(con, out: Path):
    cfg, ent = out / "config", out / "entities"
    for d in (cfg, ent):
        d.mkdir(parents=True, exist_ok=True)

    def dump(path, obj):
        path.write_text(json.dumps(obj, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")

    dump(cfg / "tag_axes.json", {"schema_version": 1,
        "tag_axes": [{"axis": r["axis"], "label": r["label"], "review_status": r["review_status"]}
                     for r in con.execute("SELECT * FROM project_tag_axes ORDER BY axis")]})
    projects = [_project_obj(con, r["id"]) for r in con.execute("SELECT id FROM projects ORDER BY id")]
    # split members out into a top-level mirror (matches People's memberships.json shape)
    memberships = []
    for p in projects:
        memberships.extend(p.pop("members", []))
    dump(ent / "projects.json", {"schema_version": 1, "projects": projects})
    dump(ent / "memberships.json", {"schema_version": 1, "memberships": memberships})


def _export_csv(con, out: Path):
    out.mkdir(parents=True, exist_ok=True)

    def write(name, header, rows):
        with (out / name).open("w", newline="", encoding="utf-8") as fh:
            w = csv.writer(fh)
            w.writerow(header)
            for row in rows:
                w.writerow(row)

    write("projects.csv", ["id", "slug", "canonical_name", "kind", "status", "review_status", "dir_path"],
          ([r["id"], r["slug"], r["canonical_name"], r["kind"], r["status"], r["review_status"], r["dir_path"]]
           for r in con.execute("SELECT * FROM projects ORDER BY id")))
    write("aliases.csv", ["project_id", "alias", "is_primary"],
          ([r["project_id"], r["alias"], r["is_primary"]] for r in con.execute("SELECT * FROM project_aliases ORDER BY project_id, alias")))
    write("links.csv", ["project_id", "kind", "url", "label"],
          ([r["project_id"], r["kind"], r["url"], r["label"]] for r in con.execute("SELECT * FROM project_links ORDER BY project_id, kind")))
    write("repos.csv", ["project_id", "name", "owner", "host", "url", "status", "review_status"],
          ([r["project_id"], r["name"], r["owner"], r["host"], r["url"], r["status"], r["review_status"]]
           for r in con.execute("SELECT * FROM repos ORDER BY project_id, name")))
    write("memberships.csv", ["project_id", "person_id", "status", "working_relationship", "can_merge", "can_deploy"],
          ([r["project_id"], r["person_id"], r["status"], r["working_relationship"], r["can_merge"], r["can_deploy"]]
           for r in con.execute("SELECT * FROM memberships ORDER BY project_id, person_id")))
    write("project_tags.csv", ["project_id", "axis", "value"],
          ([r["project_id"], r["axis"], r["value"]] for r in con.execute("SELECT * FROM project_tags ORDER BY project_id, axis, value")))
    write("membership_tags.csv", ["project_id", "person_id", "axis", "value"],
          ([r["project_id"], r["person_id"], r["axis"], r["value"]] for r in con.execute("SELECT * FROM membership_tags ORDER BY project_id, person_id, axis, value")))


# --------------------------------------------------------------------------- validate
def cmd_validate(args):
    con = connect(args)
    errs, warns = [], []
    ic = con.execute("PRAGMA integrity_check").fetchone()[0]
    if ic != "ok":
        errs.append(f"integrity_check: {ic}")
    for r in con.execute("PRAGMA foreign_key_check").fetchall():
        errs.append(f"FK violation in {r[0]} (rowid={r[1]}) -> {r[2]}")
    # every project has a primary alias
    for r in con.execute("SELECT id FROM projects WHERE NOT EXISTS "
                         "(SELECT 1 FROM project_aliases a WHERE a.project_id = projects.id AND a.is_primary = 1)"):
        errs.append(f"{r['id']}: no primary alias")
    # non-external projects should resolve to an existing dir
    for r in con.execute("SELECT id, kind, dir_path FROM projects"):
        if r["kind"] != "external":
            if not r["dir_path"]:
                warns.append(f"{r['id']}: no dir_path (kind={r['kind']})")
            elif not Path(r["dir_path"]).exists():
                warns.append(f"{r['id']}: dir_path does not exist: {r['dir_path']}")
    # alias_norm consistency
    for r in con.execute("SELECT project_id, alias_norm FROM project_aliases"):
        if r["alias_norm"] != normalize_text(r["alias_norm"]):
            errs.append(f"{r['project_id']}: alias_norm not normalized: {r['alias_norm']!r}")

    # cross-store: member person_ids resolve in People (via the pp CLI, read-only)
    if _cross is not None and _cross.available("people"):
        data = _cross.call("people", ["list", "--json"])
        if data is not None:
            valid = {p["id"] for p in data.get("persons", [])}
            for r in con.execute("SELECT DISTINCT person_id FROM memberships ORDER BY person_id"):
                if r["person_id"] not in valid:
                    errs.append(f"member person_id {r['person_id']!r} not found in People")
        else:
            warns.append("People cross-check skipped (no data from pp)")
    else:
        warns.append("People CLI unavailable; skipped person_id cross-check")

    # cross-store: every budget project (proj_*) reconciles to a registry project (via dir_path/alias)
    if _cross is not None and _cross.available("household-budget"):
        data = _cross.call("household-budget", ["projects", "--json"])
        if data is not None:
            alias_norms = {r[0] for r in con.execute("SELECT alias_norm FROM project_aliases")}
            dir_paths = {r[0] for r in con.execute("SELECT dir_path FROM projects WHERE dir_path IS NOT NULL")}
            ids = {r[0] for r in con.execute("SELECT id FROM projects")}
            for bp in data.get("projects", []):
                dp = bp.get("dir_path")
                names = [bp.get("canonical_name", "")] + list(bp.get("aliases", []))
                matched = (dp in dir_paths) or (bp.get("id") in ids) \
                    or any(normalize_text(n) in alias_norms for n in names if n)
                if not matched:
                    warns.append(f"budget project {bp.get('id')!r} ({bp.get('canonical_name')!r}) has no registry match")
        else:
            warns.append("budget cross-check skipped (no data from hb)")
    else:
        warns.append("household-budget CLI unavailable; skipped budget reconcile")

    for w in warns:
        print(f"WARN: {w}", file=sys.stderr)
    if errs:
        for e in errs:
            print(f"ERROR: {e}", file=sys.stderr)
        print(f"{len(errs)} error(s), {len(warns)} warning(s)", file=sys.stderr)
        raise SystemExit(1)
    print(f"Projects registry validation passed. ({len(warns)} warning(s))")


# --------------------------------------------------------------------------- backup
def cmd_backup(args):
    con = connect(args)
    outdir = Path(args.out) if args.out else Path(args.root) / ".registry" / "backups"
    outdir.mkdir(parents=True, exist_ok=True)
    ts = datetime.now().strftime("%Y%m%dT%H%M%S")
    dest = outdir / f"projects-{ts}.db"
    bcon = sqlite3.connect(str(dest))
    with bcon:
        con.backup(bcon)
    bcon.close()
    print(f"backup -> {dest}")
    if args.keep:
        files = sorted(outdir.glob("projects-*.db"))
        for old in files[:-args.keep]:
            old.unlink()
            print(f"pruned {old.name}")


# --------------------------------------------------------------------------- audit
def cmd_audit(args):
    con = connect(args)
    q = "SELECT seq, ts, action, tbl, entity, field, new_value, note FROM project_audit"
    params = []
    if args.entity:
        q += " WHERE entity = ?"; params.append(args.entity)
    q += " ORDER BY seq DESC LIMIT ?"; params.append(args.limit or 50)
    for r in con.execute(q, params):
        bits = " ".join(filter(None, [r["tbl"], r["entity"], r["field"], (f"={r['new_value']}" if r["new_value"] else ""), (f"({r['note']})" if r["note"] else "")]))
        print(f"  #{r['seq']:<4} {r['ts'][:19]} {r['action']:<16} {bits}")


# --------------------------------------------------------------------------- CLI
def build_parser():
    p = argparse.ArgumentParser(prog="pj", description="Projects registry engine (SQLite v1, stdlib).")
    p.add_argument("--root", default=str(DEFAULT_ROOT), help="workspace root (default: ~/Workspaces/Projects)")
    p.add_argument("--db", help="override DB path (default: <root>/.registry/projects.db)")
    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("init"); s.add_argument("--force", action="store_true")
    s.add_argument("--seed", action="store_true", help="seed base tag axes"); s.set_defaults(func=cmd_init)
    s = sub.add_parser("migrate"); s.add_argument("--dry-run", action="store_true"); s.set_defaults(func=cmd_migrate)

    s = sub.add_parser("import-legacy", help="build projects+memberships from Projects/*/teams/members")
    s.add_argument("--src", help="source dir of group folders (default: <root>)"); s.set_defaults(func=cmd_import_legacy)
    s = sub.add_parser("import-json"); s.add_argument("--src"); s.add_argument("--force", action="store_true"); s.set_defaults(func=cmd_import_json)
    s = sub.add_parser("export"); s.add_argument("--format", choices=["json", "csv", "both"], default="json"); s.add_argument("--out"); s.set_defaults(func=cmd_export)
    s = sub.add_parser("validate"); s.set_defaults(func=cmd_validate)
    s = sub.add_parser("backup"); s.add_argument("--out"); s.add_argument("--keep", type=int); s.set_defaults(func=cmd_backup)
    s = sub.add_parser("audit"); s.add_argument("--entity"); s.add_argument("--limit", type=int); s.set_defaults(func=cmd_audit)

    # reads
    s = sub.add_parser("show"); s.add_argument("--id", required=True); s.add_argument("--json", action="store_true"); s.set_defaults(func=cmd_show)
    s = sub.add_parser("list"); s.add_argument("--status", choices=["active", "inactive", "archived"])
    s.add_argument("--kind", choices=["org", "client", "category", "personal", "external"]); s.add_argument("--json", action="store_true"); s.set_defaults(func=cmd_list)
    s = sub.add_parser("projects", help="read-port: project identity (+aliases) for reconciliation"); s.add_argument("--json", action="store_true"); s.set_defaults(func=cmd_projects)
    s = sub.add_parser("members", help="read-port: memberships (People consumes this)"); s.add_argument("--project"); s.add_argument("--json", action="store_true"); s.set_defaults(func=cmd_members)
    s = sub.add_parser("repos"); s.add_argument("--project"); s.add_argument("--json", action="store_true"); s.set_defaults(func=cmd_repos)
    s = sub.add_parser("links"); s.add_argument("--project"); s.add_argument("--json", action="store_true"); s.set_defaults(func=cmd_links)
    s = sub.add_parser("report"); s.add_argument("--by", required=True); s.add_argument("--scope", choices=["project", "member", "both"], default="both"); s.set_defaults(func=cmd_report)

    # project mutators
    s = sub.add_parser("upsert-project"); s.add_argument("--id", required=True); s.add_argument("--name"); s.add_argument("--slug")
    s.add_argument("--kind", choices=["org", "client", "category", "personal", "external"]); s.add_argument("--status", choices=["active", "inactive", "archived"])
    s.add_argument("--review-status", dest="review_status", choices=["needs_review", "confirmed", "ignored"])
    s.add_argument("--dir-path", dest="dir_path"); s.add_argument("--external", action="store_true", help="no directory (dir_path=NULL)")
    s.add_argument("--summary"); s.add_argument("--last-updated", dest="last_updated"); s.add_argument("--alias", action="append", default=[]); s.set_defaults(func=cmd_upsert_project)
    s = sub.add_parser("set-status"); s.add_argument("--id", required=True); s.add_argument("--status", required=True, choices=["active", "inactive", "archived"]); s.set_defaults(func=cmd_set_status)
    s = sub.add_parser("review"); s.set_defaults(func=cmd_review)
    for name, fn in (("confirm", cmd_confirm), ("ignore", cmd_ignore)):
        s = sub.add_parser(name); s.add_argument("--id", required=True); s.set_defaults(func=fn)
    s = sub.add_parser("rename-project"); s.add_argument("--old", required=True); s.add_argument("--new", required=True); s.set_defaults(func=cmd_rename_project)
    s = sub.add_parser("merge-project"); s.add_argument("--old", required=True); s.add_argument("--into", required=True); s.set_defaults(func=cmd_merge_project)

    # facets
    s = sub.add_parser("alias-add"); s.add_argument("--id", required=True); s.add_argument("--alias", required=True); s.add_argument("--primary", action="store_true"); s.set_defaults(func=cmd_alias_add)
    s = sub.add_parser("alias-rm"); s.add_argument("--id", required=True); s.add_argument("--alias", required=True); s.set_defaults(func=cmd_alias_rm)
    s = sub.add_parser("link-set"); s.add_argument("--id", required=True); s.add_argument("--kind", required=True, choices=["landing", "x", "github", "docs", "discord", "other"]); s.add_argument("--url", required=True); s.add_argument("--label"); s.set_defaults(func=cmd_link_set)
    s = sub.add_parser("link-rm"); s.add_argument("--id", required=True); s.add_argument("--kind", required=True); s.add_argument("--url", required=True); s.set_defaults(func=cmd_link_rm)
    s = sub.add_parser("tag-set"); s.add_argument("--id", required=True); s.add_argument("--axis", required=True); s.add_argument("--value", required=True); s.add_argument("--label"); s.set_defaults(func=cmd_tag_set)
    s = sub.add_parser("tag-rm"); s.add_argument("--id", required=True); s.add_argument("--axis", required=True); s.add_argument("--value", required=True); s.set_defaults(func=cmd_tag_rm)

    # repos
    s = sub.add_parser("repo-set"); s.add_argument("--project", required=True); s.add_argument("--name", required=True)
    s.add_argument("--owner"); s.add_argument("--host"); s.add_argument("--url"); s.add_argument("--ghq-path", dest="ghq_path"); s.add_argument("--link-path", dest="link_path")
    s.add_argument("--has-agents-md", dest="has_agents_md", action="store_true", default=None); s.add_argument("--summary")
    s.add_argument("--status", choices=["declared", "linked", "missing", "archived"]); s.add_argument("--review-status", dest="review_status", choices=["needs_review", "confirmed", "ignored"]); s.set_defaults(func=cmd_repo_set)
    s = sub.add_parser("repo-rm"); s.add_argument("--project", required=True); s.add_argument("--name", required=True); s.set_defaults(func=cmd_repo_rm)
    s = sub.add_parser("link-repo"); s.add_argument("--project", required=True); s.add_argument("--name", required=True); s.set_defaults(func=cmd_link_repo)

    # members
    s = sub.add_parser("member-set"); s.add_argument("--project", required=True); s.add_argument("--person", required=True)
    s.add_argument("--status"); s.add_argument("--working-relationship", dest="working_relationship")
    s.add_argument("--can-merge", dest="can_merge", action="store_true", default=None); s.add_argument("--no-can-merge", dest="can_merge", action="store_false")
    s.add_argument("--can-deploy", dest="can_deploy", action="store_true", default=None); s.add_argument("--no-can-deploy", dest="can_deploy", action="store_false")
    s.add_argument("--role", action="append", default=[]); s.add_argument("--responsibility", action="append", default=[]); s.add_argument("--area", action="append", default=[])
    s.add_argument("--approve", action="append", default=[]); s.add_argument("--review", action="append", default=[])
    s.add_argument("--note", action="append", default=[]); s.add_argument("--contact", action="append", default=[], help="channel=handle")
    s.add_argument("--last-updated", dest="last_updated"); s.set_defaults(func=cmd_member_set)
    s = sub.add_parser("member-rm"); s.add_argument("--project", required=True); s.add_argument("--person", required=True); s.set_defaults(func=cmd_member_rm)
    s = sub.add_parser("member-role-rm"); s.add_argument("--project", required=True); s.add_argument("--person", required=True); s.add_argument("--role", required=True); s.set_defaults(func=cmd_member_role_rm)
    s = sub.add_parser("member-area-rm"); s.add_argument("--project", required=True); s.add_argument("--person", required=True); s.add_argument("--area", required=True); s.set_defaults(func=cmd_member_area_rm)
    s = sub.add_parser("mtag-set"); s.add_argument("--project", required=True); s.add_argument("--person", required=True); s.add_argument("--axis", required=True); s.add_argument("--value", required=True); s.add_argument("--label"); s.set_defaults(func=cmd_mtag_set)
    s = sub.add_parser("mtag-rm"); s.add_argument("--project", required=True); s.add_argument("--person", required=True); s.add_argument("--axis", required=True); s.add_argument("--value", required=True); s.set_defaults(func=cmd_mtag_rm)
    return p


def main(argv=None):
    args = build_parser().parse_args(argv)
    args.func(args)


if __name__ == "__main__":
    main()
