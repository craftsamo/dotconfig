#!/usr/bin/env python3
"""pp — People registry engine (SQLite v1, Python stdlib only).

Canonical person registry. The DB is the source of truth; JSON/CSV under data/export/
is a regenerable mirror. See ../references/data-model.md. Data is sensitive — handle per
Personal/AGENTS.md (summarize; never paste raw records into chat/logs).

Subcommands:
  init            create a fresh DB from schema.sql (user_version = 1); --seed adds base lookups + sentinel
  migrate         apply pending migrations/ (NNNN_*.sql|.py) by user_version
  import-json     load a mirror (config/ + entities/) into an empty DB
  export          regenerate JSON and/or CSV mirror from the DB
  validate        integrity + referential + cross-store checks
  upsert-person   create or update a person (stable bare-slug id)
  set-status      flip a person's lifecycle status (active|inactive)
  confirm/ignore  flip a person's review_status (id never changes); review lists pending
  rename-person   FK-safe id rename
  merge-person    FK-safe merge of a duplicate into another
  alias-add/-rm   manage searchable aliases
  contact-set/-rm manage contact handles (per channel)
  lang-add/-rm    manage spoken languages
  nat-add/-rm     manage nationalities
  note-add        append a note
  tag-set/-rm     manage free-axis tags (axis registered on demand)
  rel-add/-rm     manage person<->person relationships
  show/list/search/whois  read helpers (whois resolves a handle/name -> person_id)
  import-projects rebuild the membership mirror from ~/Workspaces/Projects/*/teams/members
  backup          snapshot the DB to data/backups/ (with optional retention)
  audit           show recent change history

No third-party deps. People ids are bare lowercase slugs (== the person_id consumers use).
"""
from __future__ import annotations

import argparse
import csv
import json
import re
import sqlite3
import sys
import unicodedata
from datetime import datetime, timezone
from pathlib import Path

DEFAULT_ROOT = Path.home() / "Workspaces" / "Personal" / "People"
SKILL_DIR = Path(__file__).resolve().parent.parent
SCHEMA_PATH = SKILL_DIR / "schema.sql"
MIGRATIONS_DIR = SKILL_DIR / "migrations"
PROJECTS_DIR = Path.home() / "Workspaces" / "Projects"
SENTINEL = "person_unknown"

# base lookups seeded by `init --seed` / migrate_people (kept lean; auto-extended on demand)
SEED_COUNTRIES = {"JP": "Japan", "MY": "Malaysia", "ID": "Indonesia"}
SEED_LANGUAGES = {"ja": "Japanese", "en": "English", "id": "Indonesian", "ms": "Malay"}
SEED_CHANNELS = [
    ("github", "GitHub", 0), ("telegram", "Telegram", 0), ("x", "X / Twitter", 0),
    ("website", "Website", 0), ("signal", "Signal", 0), ("matrix", "Matrix", 0),
    ("discord", "Discord", 0), ("linkedin", "LinkedIn", 0),
    ("email", "Email", 1), ("phone", "Phone", 1),
]
SEED_AXES = {
    "comms": "Communication preferences", "how_we_met": "How we met",
    "team": "Team", "interests": "Interests", "availability": "Availability",
}

# child tables carrying a person_id column (for rename/merge id rewrites).
PERSON_CHILD_TABLES = [
    "person_aliases", "person_contacts", "person_languages", "person_nationalities",
    "person_notes", "person_tags", "person_project_memberships",
    "membership_roles", "membership_responsibilities", "membership_areas",
    "membership_permission_scopes", "membership_notes", "membership_contacts",
]


# --------------------------------------------------------------------------- helpers
def die(msg: str):
    print(f"pp: {msg}", file=sys.stderr)
    raise SystemExit(1)


def now_iso() -> str:
    return datetime.now(timezone.utc).isoformat()


def today() -> str:
    return datetime.now().strftime("%Y-%m-%d")


def load(path: Path) -> dict:
    return json.loads(Path(path).read_text(encoding="utf-8"))


def normalize_text(s) -> str:
    s = unicodedata.normalize("NFKC", s or "")
    s = s.casefold()
    return re.sub(r"\s+", " ", s).strip()


def normalize_handle(s) -> str:
    n = normalize_text(s)
    n = re.sub(r"^(https?://)?(t\.me/|x\.com/|twitter\.com/|github\.com/)", "", n)
    return n.lstrip("@").strip("/")


def slugify(s) -> str:
    s = unicodedata.normalize("NFKD", s or "")
    s = s.encode("ascii", "ignore").decode("ascii").casefold()
    s = re.sub(r"[^a-z0-9]+", "_", s).strip("_")
    return s or "unknown"


def db_path(args) -> Path:
    if getattr(args, "db", None):
        return Path(args.db)
    return Path(args.root) / "data" / "people.db"


def connect(args, *, must_exist=True) -> sqlite3.Connection:
    p = db_path(args)
    if must_exist and not p.exists():
        die(f"DB not found: {p}  (run: pp init)")
    con = sqlite3.connect(str(p))
    con.isolation_level = None
    con.row_factory = sqlite3.Row
    con.execute("PRAGMA foreign_keys = ON")
    return con


def _audit(con, person_id, action, tbl=None, field=None, old=None, new=None, note=None):
    con.execute(
        "INSERT INTO person_audit(person_id, ts, action, tbl, field, old_value, new_value, note) "
        "VALUES (?,?,?,?,?,?,?,?)",
        (person_id, now_iso(), action, tbl, field,
         None if old is None else str(old), None if new is None else str(new), note))


# ----- lookup ensure (auto-extend registries) -----
def _ensure_country(con, code, label=None):
    if not code:
        return None
    code = code.strip().upper()
    con.execute("INSERT OR IGNORE INTO countries(code, label) VALUES (?,?)", (code, label or code))
    return code


def _ensure_language(con, code, label=None):
    if not code:
        return None
    code = code.strip().lower()
    con.execute("INSERT OR IGNORE INTO languages(code, label) VALUES (?,?)", (code, label or code))
    return code


def _ensure_channel(con, channel, label=None, sensitive=0):
    if not channel:
        return None
    ch = channel.strip().lower()
    con.execute("INSERT OR IGNORE INTO contact_channels(channel, label, is_sensitive) VALUES (?,?,?)",
                (ch, label or ch, sensitive))
    return ch


def _ensure_axis(con, axis, label=None):
    ax = axis.strip().lower()
    con.execute("INSERT OR IGNORE INTO person_tag_axes(axis, label, review_status) VALUES (?,?, 'confirmed')",
                (ax, label or ax))
    return ax


def _seed_base(con):
    for code, label in SEED_COUNTRIES.items():
        con.execute("INSERT OR IGNORE INTO countries(code, label) VALUES (?,?)", (code, label))
    for code, label in SEED_LANGUAGES.items():
        con.execute("INSERT OR IGNORE INTO languages(code, label) VALUES (?,?)", (code, label))
    for ch, label, sens in SEED_CHANNELS:
        con.execute("INSERT OR IGNORE INTO contact_channels(channel, label, is_sensitive) VALUES (?,?,?)",
                    (ch, label, sens))
    for ax, label in SEED_AXES.items():
        con.execute("INSERT OR IGNORE INTO person_tag_axes(axis, label, review_status) VALUES (?,?, 'confirmed')",
                    (ax, label))
    now = now_iso()
    con.execute(
        "INSERT OR IGNORE INTO persons(id, display_name, kind, status, review_status, created_at, updated_at) "
        "VALUES (?,?,?,?,?,?,?)", (SENTINEL, "Unknown person", "individual", "active", "confirmed", now, now))


def _need_person(con, pid):
    if not con.execute("SELECT 1 FROM persons WHERE id = ?", (pid,)).fetchone():
        die(f"no person with id {pid}")


def _add_alias(con, pid, name, primary=False):
    norm = normalize_text(name)
    if not norm:
        return
    con.execute("INSERT OR IGNORE INTO person_aliases(person_id, alias, alias_norm, is_primary) VALUES (?,?,?,?)",
                (pid, name, norm, 1 if primary else 0))
    if primary:
        con.execute("UPDATE person_aliases SET is_primary = 0 WHERE person_id = ? AND alias_norm != ?", (pid, norm))
        con.execute("UPDATE person_aliases SET is_primary = 1 WHERE person_id = ? AND alias_norm = ?", (pid, norm))


# --------------------------------------------------------------------------- init / migrate
def cmd_init(args):
    p = db_path(args)
    if p.exists():
        if not args.force:
            die(f"DB already exists: {p}  (use --force to recreate, or pp migrate to upgrade)")
        p.unlink()
    p.parent.mkdir(parents=True, exist_ok=True)
    con = sqlite3.connect(str(p))
    con.executescript(SCHEMA_PATH.read_text(encoding="utf-8"))
    if args.seed:
        con.execute("PRAGMA foreign_keys = ON")
        _seed_base(con)
    con.commit()
    con.close()
    print(f"initialized {p} (user_version=1)" + (" + seeded base lookups/sentinel" if args.seed else ""))


def _migration_files():
    out = []
    if MIGRATIONS_DIR.exists():
        for f in sorted(MIGRATIONS_DIR.iterdir()):
            m = re.match(r"^(\d+)_.*\.(sql|py)$", f.name)
            if m:
                out.append((int(m.group(1)), f))
    return sorted(out)


def cmd_migrate(args):
    import importlib.util
    con = connect(args)
    cur = con.execute("PRAGMA user_version").fetchone()[0]
    pending = [(v, f) for v, f in _migration_files() if v > cur]
    if not pending:
        print(f"up to date (user_version={cur})")
        return
    for v, f in pending:
        if args.dry_run:
            print(f"would apply {f.name} -> user_version={v}")
            continue
        if f.suffix == ".sql":
            body = f.read_text(encoding="utf-8")
            try:
                con.executescript(f"BEGIN;\n{body}\nPRAGMA user_version = {v};\nCOMMIT;")
            except Exception:
                try:
                    con.execute("ROLLBACK")
                except Exception:
                    pass
                raise
        else:
            con.execute("BEGIN")
            con.execute("PRAGMA defer_foreign_keys = ON")
            try:
                spec = importlib.util.spec_from_file_location(f.stem, f)
                mod = importlib.util.module_from_spec(spec)
                spec.loader.exec_module(mod)
                mod.up(con)
                bad = con.execute("PRAGMA foreign_key_check").fetchall()
                if bad:
                    raise RuntimeError(f"foreign_key_check failed after {f.name}: {bad}")
                con.execute(f"PRAGMA user_version = {v}")
                con.execute("COMMIT")
            except Exception:
                con.execute("ROLLBACK")
                raise
        print(f"applied {f.name} -> user_version={v}")


# --------------------------------------------------------------------------- import-json
def cmd_import(args):
    src = Path(args.src) if args.src else Path(args.root) / "data" / "export"
    con = connect(args)
    n = con.execute("SELECT COUNT(*) FROM persons WHERE id != ?", (SENTINEL,)).fetchone()[0]
    if n and not args.force:
        die(f"DB already has {n} person(s) (use --force to re-import into an empty DB)")
    con.execute("BEGIN")
    con.execute("PRAGMA defer_foreign_keys = ON")
    try:
        cfg = src / "config"
        if (cfg / "countries.json").exists():
            for c in load(cfg / "countries.json")["countries"]:
                con.execute("INSERT OR IGNORE INTO countries(code, label) VALUES (?,?)", (c["code"], c["label"]))
        if (cfg / "languages.json").exists():
            for c in load(cfg / "languages.json")["languages"]:
                con.execute("INSERT OR IGNORE INTO languages(code, label) VALUES (?,?)", (c["code"], c["label"]))
        if (cfg / "contact_channels.json").exists():
            for c in load(cfg / "contact_channels.json")["contact_channels"]:
                con.execute("INSERT OR IGNORE INTO contact_channels(channel, label, is_sensitive) VALUES (?,?,?)",
                            (c["channel"], c["label"], int(c.get("is_sensitive", 0))))
        if (cfg / "tag_axes.json").exists():
            for a in load(cfg / "tag_axes.json")["tag_axes"]:
                con.execute("INSERT OR IGNORE INTO person_tag_axes(axis, label, review_status) VALUES (?,?,?)",
                            (a["axis"], a.get("label", a["axis"]), a.get("review_status", "confirmed")))
        pf = src / "entities" / "persons.json"
        for p in load(pf)["persons"]:
            con.execute(
                "INSERT OR REPLACE INTO persons(id, display_name, kind, status, review_status, residence_country, "
                "preferred_language, preferred_contact_channel, timezone, last_updated, created_at, updated_at) "
                "VALUES (?,?,?,?,?,?,?,?,?,?,?,?)",
                (p["id"], p["display_name"], p.get("kind", "individual"), p.get("status", "active"),
                 p.get("review_status", "confirmed"), p.get("residence_country"), p.get("preferred_language"),
                 p.get("preferred_contact_channel"), p.get("timezone"), p.get("last_updated"),
                 p.get("created_at") or now_iso(), p.get("updated_at") or now_iso()))
            for a in p.get("aliases", []):
                con.execute("INSERT OR IGNORE INTO person_aliases(person_id, alias, alias_norm, is_primary) VALUES (?,?,?,?)",
                            (p["id"], a["alias"], normalize_text(a["alias"]), int(a.get("is_primary", 0))))
            for c in p.get("contacts", []):
                con.execute("INSERT OR IGNORE INTO person_contacts(person_id, channel, handle, handle_norm, is_primary) "
                            "VALUES (?,?,?,?,?)",
                            (p["id"], c["channel"], c["handle"], normalize_handle(c["handle"]), int(c.get("is_primary", 0))))
            for l in p.get("languages", []):
                con.execute("INSERT OR IGNORE INTO person_languages(person_id, language, proficiency, is_primary) VALUES (?,?,?,?)",
                            (p["id"], l["language"], l.get("proficiency"), int(l.get("is_primary", 0))))
            for nat in p.get("nationalities", []):
                con.execute("INSERT OR IGNORE INTO person_nationalities(person_id, country, is_primary) VALUES (?,?,?)",
                            (p["id"], nat["country"], int(nat.get("is_primary", 0))))
            for i, note in enumerate(p.get("notes", []), start=1):
                txt = note["text"] if isinstance(note, dict) else note
                con.execute("INSERT OR IGNORE INTO person_notes(person_id, seq, text, created_at) VALUES (?,?,?,?)",
                            (p["id"], i, txt, (note.get("created_at") if isinstance(note, dict) else None) or now_iso()))
            for t in p.get("tags", []):
                _ensure_axis(con, t["axis"])
                con.execute("INSERT OR IGNORE INTO person_tags(person_id, axis, value, value_norm) VALUES (?,?,?,?)",
                            (p["id"], t["axis"], t["value"], normalize_text(t["value"])))
        # relationships after all persons exist
        for p in load(pf)["persons"]:
            for rel in p.get("relationships", []):
                con.execute("INSERT OR IGNORE INTO person_relationships(from_person_id, to_person_id, type, note) VALUES (?,?,?,?)",
                            (p["id"], rel["to"], rel["type"], rel.get("note")))
        mf = src / "entities" / "memberships.json"
        mc = 0
        if mf.exists():
            for m in load(mf)["memberships"]:
                perms = m.get("permissions") or {}
                con.execute("INSERT OR REPLACE INTO person_project_memberships(person_id, project_id, status, "
                            "working_relationship, can_merge, can_deploy, source_path, last_synced_at) VALUES (?,?,?,?,?,?,?,?)",
                            (m["person_id"], m["project_id"], m.get("status"), m.get("working_relationship"),
                             1 if perms.get("can_merge") else 0, 1 if perms.get("can_deploy") else 0,
                             m.get("source_path"), m.get("last_synced_at")))
                for role in m.get("roles", []):
                    con.execute("INSERT OR IGNORE INTO membership_roles VALUES (?,?,?)", (m["person_id"], m["project_id"], role))
                for r in m.get("responsibilities", []):
                    con.execute("INSERT OR IGNORE INTO membership_responsibilities VALUES (?,?,?)", (m["person_id"], m["project_id"], r))
                for a in m.get("areas", []):
                    con.execute("INSERT OR IGNORE INTO membership_areas VALUES (?,?,?)", (m["person_id"], m["project_id"], a))
                for t in perms.get("can_approve", []):
                    con.execute("INSERT OR IGNORE INTO membership_permission_scopes VALUES (?,?,?,?)", (m["person_id"], m["project_id"], "approve", t))
                for t in perms.get("can_review", []):
                    con.execute("INSERT OR IGNORE INTO membership_permission_scopes VALUES (?,?,?,?)", (m["person_id"], m["project_id"], "review", t))
                for i, note in enumerate(m.get("notes", []), start=1):
                    con.execute("INSERT OR IGNORE INTO membership_notes VALUES (?,?,?,?)", (m["person_id"], m["project_id"], i, note))
                for ch, h in (m.get("project_contacts") or {}).items():
                    con.execute("INSERT OR IGNORE INTO membership_contacts VALUES (?,?,?,?)", (m["person_id"], m["project_id"], ch, h))
                mc += 1
        con.execute("COMMIT")
    except Exception:
        con.execute("ROLLBACK")
        raise
    pc = con.execute("SELECT COUNT(*) FROM persons").fetchone()[0]
    print(f"imported: {pc} persons, {mc} memberships from {src}")


# --------------------------------------------------------------------------- validate
def cmd_validate(args):
    con = connect(args)
    errs = []
    ic = con.execute("PRAGMA integrity_check").fetchone()[0]
    if ic != "ok":
        errs.append(f"integrity_check: {ic}")
    for r in con.execute("PRAGMA foreign_key_check").fetchall():
        errs.append(f"FK violation in {r[0]} (rowid={r[1]}) -> {r[2]}")
    if not con.execute("SELECT 1 FROM persons WHERE id = ?", (SENTINEL,)).fetchone():
        errs.append(f"missing sentinel {SENTINEL} in persons")
    for r in con.execute("SELECT id FROM persons WHERE id != ? AND NOT EXISTS "
                         "(SELECT 1 FROM person_aliases a WHERE a.person_id = persons.id AND a.is_primary = 1)", (SENTINEL,)):
        errs.append(f"{r['id']}: no primary alias")
    for r in con.execute("SELECT alias_norm, person_id FROM person_aliases"):
        if r["alias_norm"] != normalize_text(r["alias_norm"]):
            errs.append(f"{r['person_id']}: alias_norm not normalized: {r['alias_norm']!r}")
    # cross-store: every Projects member references an existing person
    if PROJECTS_DIR.exists():
        valid = {x[0] for x in con.execute("SELECT id FROM persons")}
        for proj in sorted(PROJECTS_DIR.iterdir()):
            mdir = proj / "teams" / "members"
            if not mdir.is_dir():
                continue
            for f in sorted(mdir.glob("*.json")):
                try:
                    pid = load(f).get("person_id") or f.stem
                except Exception as e:
                    errs.append(f"{f}: unreadable ({e})")
                    continue
                if pid not in valid:
                    errs.append(f"{proj.name}/teams/members/{f.name}: person_id {pid!r} not in People")
    # mutual cross-store: every budget person-counterparty must resolve into People. Read the
    # budget's LIVE DB read-only; skip gracefully if absent or on an older schema.
    budget_db = Path(args.budget_db) if getattr(args, "budget_db", None) else \
        Path.home() / "Workspaces" / "Personal" / "HouseholdBudget" / "data" / "budget.db"
    if budget_db.exists():
        people_ids = {x[0] for x in con.execute("SELECT id FROM persons")}
        cps = None
        try:
            bcon = sqlite3.connect(f"file:{budget_db}?mode=ro", uri=True)
            try:
                cps = bcon.execute("SELECT id, person_id FROM counterparties WHERE type = 'person'").fetchall()
            finally:
                bcon.close()
        except sqlite3.Error as e:
            print(f"WARN: cannot read budget DB ({budget_db}): {e}; skipping reverse cross-check", file=sys.stderr)
        if cps is not None:
            for cid, pid in cps:
                if not pid:
                    errs.append(f"budget counterparty {cid}: type=person without person_id")
                elif pid not in people_ids:
                    errs.append(f"budget counterparty {cid}: person_id {pid!r} not in People")
    if errs:
        for e in errs:
            print(f"ERROR: {e}", file=sys.stderr)
        print(f"{len(errs)} error(s)", file=sys.stderr)
        raise SystemExit(1)
    print("People DB validation passed.")


# --------------------------------------------------------------------------- read helpers
def _person_obj(con, pid, with_memberships=True):
    p = con.execute("SELECT * FROM persons WHERE id = ?", (pid,)).fetchone()
    if not p:
        return None
    obj = {
        "id": p["id"], "display_name": p["display_name"], "kind": p["kind"], "status": p["status"],
        "review_status": p["review_status"], "residence_country": p["residence_country"],
        "preferred_language": p["preferred_language"], "preferred_contact_channel": p["preferred_contact_channel"],
        "timezone": p["timezone"], "last_updated": p["last_updated"],
        "created_at": p["created_at"], "updated_at": p["updated_at"],
        "aliases": [{"alias": r["alias"], "is_primary": bool(r["is_primary"])} for r in
                    con.execute("SELECT alias, is_primary FROM person_aliases WHERE person_id = ? ORDER BY is_primary DESC, alias", (pid,))],
        "contacts": [{"channel": r["channel"], "handle": r["handle"], "is_primary": bool(r["is_primary"])} for r in
                     con.execute("SELECT channel, handle, is_primary FROM person_contacts WHERE person_id = ? ORDER BY is_primary DESC, channel", (pid,))],
        "languages": [{"language": r["language"], "proficiency": r["proficiency"], "is_primary": bool(r["is_primary"])} for r in
                      con.execute("SELECT language, proficiency, is_primary FROM person_languages WHERE person_id = ? ORDER BY is_primary DESC, language", (pid,))],
        "nationalities": [{"country": r["country"], "is_primary": bool(r["is_primary"])} for r in
                          con.execute("SELECT country, is_primary FROM person_nationalities WHERE person_id = ? ORDER BY is_primary DESC, country", (pid,))],
        "notes": [{"seq": r["seq"], "text": r["text"], "created_at": r["created_at"]} for r in
                  con.execute("SELECT seq, text, created_at FROM person_notes WHERE person_id = ? ORDER BY seq", (pid,))],
        "tags": [{"axis": r["axis"], "value": r["value"]} for r in
                 con.execute("SELECT axis, value FROM person_tags WHERE person_id = ? ORDER BY axis, value", (pid,))],
        "relationships": [{"to": r["to_person_id"], "type": r["type"], "note": r["note"]} for r in
                          con.execute("SELECT to_person_id, type, note FROM person_relationships WHERE from_person_id = ? ORDER BY to_person_id, type", (pid,))],
    }
    if with_memberships:
        obj["memberships"] = _memberships_for(con, pid)
    return obj


def _memberships_for(con, pid):
    out = []
    for m in con.execute("SELECT * FROM person_project_memberships WHERE person_id = ? ORDER BY project_id", (pid,)):
        proj = m["project_id"]
        out.append({
            "project_id": proj, "status": m["status"], "working_relationship": m["working_relationship"],
            "roles": [r[0] for r in con.execute("SELECT role FROM membership_roles WHERE person_id=? AND project_id=? ORDER BY role", (pid, proj))],
            "responsibilities": [r[0] for r in con.execute("SELECT responsibility FROM membership_responsibilities WHERE person_id=? AND project_id=? ORDER BY responsibility", (pid, proj))],
            "areas": [r[0] for r in con.execute("SELECT area FROM membership_areas WHERE person_id=? AND project_id=? ORDER BY area", (pid, proj))],
            "permissions": {
                "can_approve": [r[0] for r in con.execute("SELECT target FROM membership_permission_scopes WHERE person_id=? AND project_id=? AND action='approve' ORDER BY target", (pid, proj))],
                "can_review": [r[0] for r in con.execute("SELECT target FROM membership_permission_scopes WHERE person_id=? AND project_id=? AND action='review' ORDER BY target", (pid, proj))],
                "can_merge": bool(m["can_merge"]), "can_deploy": bool(m["can_deploy"]),
            },
            "project_contacts": {r["channel"]: r["handle"] for r in con.execute("SELECT channel, handle FROM membership_contacts WHERE person_id=? AND project_id=?", (pid, proj))},
            "notes": [r[0] for r in con.execute("SELECT text FROM membership_notes WHERE person_id=? AND project_id=? ORDER BY seq", (pid, proj))],
            "source_path": m["source_path"], "last_synced_at": m["last_synced_at"],
        })
    return out


def cmd_show(args):
    con = connect(args)
    obj = _person_obj(con, args.id)
    if not obj:
        die(f"no person with id {args.id}")
    print(json.dumps(obj, ensure_ascii=False, indent=2))


def cmd_list(args):
    con = connect(args)
    q = "SELECT id, display_name, kind, status, review_status, residence_country, preferred_language FROM persons WHERE 1=1"
    params = []
    if args.status:
        q += " AND status = ?"; params.append(args.status)
    if args.kind:
        q += " AND kind = ?"; params.append(args.kind)
    if getattr(args, "project", None):
        q += " AND id IN (SELECT person_id FROM person_project_memberships WHERE project_id = ?)"; params.append(args.project)
    q += " ORDER BY id"
    rows = con.execute(q, params).fetchall()
    for r in rows:
        extra = " ".join(filter(None, [r["residence_country"], (f"lang={r['preferred_language']}" if r["preferred_language"] else "")]))
        print(f"  {r['id']:<12} {r['display_name']:<16} {r['kind']:<10} {r['status']:<8} {r['review_status']:<12} {extra}")
    print(f"{len(rows)} person(s)")


def cmd_search(args):
    con = connect(args)
    qn = normalize_text(args.query)
    hn = normalize_handle(args.query)
    ids = set()
    if con.execute("SELECT 1 FROM persons WHERE id = ?", (args.query,)).fetchone():
        ids.add(args.query)
    for r in con.execute("SELECT person_id FROM person_aliases WHERE alias_norm LIKE ?", (f"%{qn}%",)):
        ids.add(r[0])
    for r in con.execute("SELECT person_id FROM person_contacts WHERE handle_norm LIKE ?", (f"%{hn}%",)):
        ids.add(r[0])
    for pid in sorted(ids):
        p = con.execute("SELECT display_name, status FROM persons WHERE id = ?", (pid,)).fetchone()
        print(f"  {pid:<12} {p['display_name']:<16} {p['status']}")
    print(f"{len(ids)} match(es)")


def cmd_whois(args):
    con = connect(args)
    qn = normalize_text(args.query)
    hn = normalize_handle(args.query)
    ids = []
    seen = set()

    def add(pid):
        if pid and pid not in seen:
            seen.add(pid); ids.append(pid)

    if con.execute("SELECT 1 FROM persons WHERE id = ?", (args.query,)).fetchone():
        add(args.query)
    for r in con.execute("SELECT person_id FROM person_contacts WHERE handle_norm = ?", (hn,)):
        add(r[0])
    for r in con.execute("SELECT person_id FROM person_aliases WHERE alias_norm = ?", (qn,)):
        add(r[0])
    if not ids:
        for r in con.execute("SELECT DISTINCT person_id FROM person_aliases WHERE alias_norm LIKE ?", (f"%{qn}%",)):
            add(r[0])
        for r in con.execute("SELECT DISTINCT person_id FROM person_contacts WHERE handle_norm LIKE ?", (f"%{hn}%",)):
            add(r[0])
    out = {"query": args.query, "matches": [_person_obj(con, pid) for pid in ids]}
    print(json.dumps(out, ensure_ascii=False, indent=2))


# --------------------------------------------------------------------------- mutators
def cmd_upsert(args):
    con = connect(args)
    pid = args.id or slugify(args.name or "")
    if not pid or pid == "unknown" and not args.id:
        die("provide --id or a --name to derive the id from")
    exists = con.execute("SELECT * FROM persons WHERE id = ?", (pid,)).fetchone()
    now = now_iso()
    con.execute("BEGIN")
    try:
        if exists:
            fields = {}
            if args.name is not None:
                fields["display_name"] = args.name
            if args.kind:
                fields["kind"] = args.kind
            if args.status:
                fields["status"] = args.status
            if args.review_status:
                fields["review_status"] = args.review_status
            if args.timezone is not None:
                fields["timezone"] = args.timezone or None
            if args.residence is not None:
                fields["residence_country"] = _ensure_country(con, args.residence) if args.residence else None
            if args.preferred_language is not None:
                fields["preferred_language"] = _ensure_language(con, args.preferred_language) if args.preferred_language else None
            if args.preferred_contact_channel is not None:
                fields["preferred_contact_channel"] = _ensure_channel(con, args.preferred_contact_channel) if args.preferred_contact_channel else None
            fields["updated_at"] = now
            fields["last_updated"] = args.last_updated or today()
            sets = ", ".join(f"{k} = ?" for k in fields)
            con.execute(f"UPDATE persons SET {sets} WHERE id = ?", (*fields.values(), pid))
            for k, v in fields.items():
                if k not in ("updated_at", "last_updated"):
                    _audit(con, pid, "update", "persons", k, None, v)
            action = "updated"
        else:
            if not args.name:
                die("new person requires --name")
            residence = _ensure_country(con, args.residence) if args.residence else None
            plang = _ensure_language(con, args.preferred_language) if args.preferred_language else None
            pcc = _ensure_channel(con, args.preferred_contact_channel) if args.preferred_contact_channel else None
            con.execute(
                "INSERT INTO persons(id, display_name, kind, status, review_status, residence_country, "
                "preferred_language, preferred_contact_channel, timezone, last_updated, created_at, updated_at) "
                "VALUES (?,?,?,?,?,?,?,?,?,?,?,?)",
                (pid, args.name, args.kind or "individual", args.status or "active",
                 args.review_status or "needs_review", residence, plang, pcc, args.timezone,
                 args.last_updated or today(), now, now))
            _audit(con, pid, "create", "persons", None, None, pid)
            action = "created"
        _add_alias(con, pid, args.name or pid, primary=True)
        for a in (args.alias or []):
            _add_alias(con, pid, a, primary=False)
        for code in (args.language or []):
            _ensure_language(con, code)
            con.execute("INSERT OR IGNORE INTO person_languages(person_id, language, is_primary) VALUES (?,?,0)", (pid, code.strip().lower()))
        for code in (args.nationality or []):
            _ensure_country(con, code)
            con.execute("INSERT OR IGNORE INTO person_nationalities(person_id, country, is_primary) VALUES (?,?,0)", (pid, code.strip().upper()))
        con.execute("COMMIT")
    except Exception:
        con.execute("ROLLBACK")
        raise
    print(json.dumps({"action": action, "id": pid}, ensure_ascii=False))


