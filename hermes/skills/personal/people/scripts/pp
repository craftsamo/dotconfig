# --------------------------------------------------------------------------- rename / merge
def cmd_rename(args):
    con = connect(args)
    _need_person(con, args.old)
    if con.execute("SELECT 1 FROM persons WHERE id = ?", (args.new,)).fetchone():
        die(f"target id {args.new} already exists (use merge-person)")
    con.execute("BEGIN")
    con.execute("PRAGMA defer_foreign_keys = ON")
    try:
        con.execute("UPDATE persons SET id = ?, updated_at = ? WHERE id = ?", (args.new, now_iso(), args.old))
        for tbl in PERSON_CHILD_TABLES:
            con.execute(f"UPDATE {tbl} SET person_id = ? WHERE person_id = ?", (args.new, args.old))
        con.execute("UPDATE person_relationships SET from_person_id = ? WHERE from_person_id = ?", (args.new, args.old))
        con.execute("UPDATE person_relationships SET to_person_id = ? WHERE to_person_id = ?", (args.new, args.old))
        con.execute("UPDATE person_audit SET person_id = ? WHERE person_id = ?", (args.new, args.old))
        bad = con.execute("PRAGMA foreign_key_check").fetchall()
        if bad:
            raise RuntimeError(f"foreign_key_check failed: {bad}")
        _audit(con, args.new, "rename", "persons", "id", args.old, args.new)
        con.execute("COMMIT")
    except Exception:
        con.execute("ROLLBACK")
        raise
    print(json.dumps({"action": "renamed", "from": args.old, "to": args.new}, ensure_ascii=False))


def cmd_merge(args):
    con = connect(args)
    _need_person(con, args.old)
    _need_person(con, args.into)
    if args.old == args.into:
        die("old and into are the same")
    con.execute("BEGIN")
    con.execute("PRAGMA defer_foreign_keys = ON")
    try:
        for tbl in PERSON_CHILD_TABLES:
            con.execute(f"UPDATE OR IGNORE {tbl} SET person_id = ? WHERE person_id = ?", (args.into, args.old))
            con.execute(f"DELETE FROM {tbl} WHERE person_id = ?", (args.old,))
        con.execute("UPDATE OR IGNORE person_relationships SET from_person_id = ? WHERE from_person_id = ?", (args.into, args.old))
        con.execute("UPDATE OR IGNORE person_relationships SET to_person_id = ? WHERE to_person_id = ?", (args.into, args.old))
        con.execute("DELETE FROM person_relationships WHERE from_person_id = ? OR to_person_id = ?", (args.old, args.old))
        con.execute("DELETE FROM person_relationships WHERE from_person_id = to_person_id")
        con.execute("DELETE FROM persons WHERE id = ?", (args.old,))
        bad = con.execute("PRAGMA foreign_key_check").fetchall()
        if bad:
            raise RuntimeError(f"foreign_key_check failed: {bad}")
        _audit(con, args.into, "merge", "persons", "id", args.old, args.into)
        con.execute("COMMIT")
    except Exception:
        con.execute("ROLLBACK")
        raise
    print(json.dumps({"action": "merged", "from": args.old, "into": args.into}, ensure_ascii=False))


# --------------------------------------------------------------------------- import-projects
def cmd_import_projects(args):
    con = connect(args)
    valid = {r[0] for r in con.execute("SELECT id FROM persons")}
    now = now_iso()
    count, orphans = 0, []
    con.execute("BEGIN")
    try:
        con.execute("DELETE FROM person_project_memberships")  # children cascade
        if PROJECTS_DIR.exists():
            for proj in sorted(PROJECTS_DIR.iterdir()):
                mdir = proj / "teams" / "members"
                if not mdir.is_dir():
                    continue
                for f in sorted(mdir.glob("*.json")):
                    m = load(f)
                    pid = m.get("person_id") or f.stem
                    if pid not in valid:
                        orphans.append({"person_id": pid, "project": proj.name})
                        continue
                    perms = m.get("permissions") or {}
                    con.execute("INSERT INTO person_project_memberships(person_id, project_id, status, working_relationship, "
                                "can_merge, can_deploy, source_path, last_synced_at) VALUES (?,?,?,?,?,?,?,?)",
                                (pid, proj.name, m.get("status"), m.get("working_relationship"),
                                 1 if perms.get("can_merge") else 0, 1 if perms.get("can_deploy") else 0, str(f), now))
                    for role in m.get("roles") or []:
                        con.execute("INSERT OR IGNORE INTO membership_roles VALUES (?,?,?)", (pid, proj.name, role))
                    for r in m.get("responsibilities") or []:
                        con.execute("INSERT OR IGNORE INTO membership_responsibilities VALUES (?,?,?)", (pid, proj.name, r))
                    for a in m.get("areas") or []:
                        con.execute("INSERT OR IGNORE INTO membership_areas VALUES (?,?,?)", (pid, proj.name, a))
                    for t in perms.get("can_approve") or []:
                        con.execute("INSERT OR IGNORE INTO membership_permission_scopes VALUES (?,?,?,?)", (pid, proj.name, "approve", t))
                    for t in perms.get("can_review") or []:
                        con.execute("INSERT OR IGNORE INTO membership_permission_scopes VALUES (?,?,?,?)", (pid, proj.name, "review", t))
                    for i, note in enumerate(m.get("notes") or [], start=1):
                        con.execute("INSERT OR IGNORE INTO membership_notes VALUES (?,?,?,?)", (pid, proj.name, i, note))
                    for ch, h in (m.get("project_contacts") or {}).items():
                        con.execute("INSERT OR IGNORE INTO membership_contacts VALUES (?,?,?,?)", (pid, proj.name, ch, h))
                    count += 1
        _audit(con, None, "import-projects", "person_project_memberships", None, None, f"{count} memberships, {len(orphans)} orphans")
        con.execute("COMMIT")
    except Exception:
        con.execute("ROLLBACK")
        raise
    print(json.dumps({"action": "import-projects", "memberships": count, "orphans": orphans}, ensure_ascii=False))


# --------------------------------------------------------------------------- backup
def cmd_backup(args):
    con = connect(args)
    outdir = Path(args.out) if args.out else Path(args.root) / "data" / "backups"
    outdir.mkdir(parents=True, exist_ok=True)
    ts = datetime.now().strftime("%Y%m%dT%H%M%S")
    dest = outdir / f"people-{ts}.db"
    bcon = sqlite3.connect(str(dest))
    with bcon:
        con.backup(bcon)
    bcon.close()
    print(f"backup -> {dest}")
    if args.keep:
        files = sorted(outdir.glob("people-*.db"))
        for old in files[:-args.keep]:
            old.unlink()
            print(f"pruned {old.name}")


# --------------------------------------------------------------------------- audit
def cmd_audit(args):
    con = connect(args)
    q = "SELECT seq, ts, person_id, action, tbl, field, new_value, note FROM person_audit"
    params = []
    if args.id:
        q += " WHERE person_id = ?"; params.append(args.id)
    q += " ORDER BY seq DESC LIMIT ?"; params.append(args.limit or 50)
    for r in con.execute(q, params):
        bits = " ".join(filter(None, [r["tbl"], r["field"], (f"={r['new_value']}" if r["new_value"] else ""), (f"({r['note']})" if r["note"] else "")]))
        print(f"  #{r['seq']:<4} {r['ts'][:19]} {r['person_id'] or '-':<12} {r['action']:<16} {bits}")


# --------------------------------------------------------------------------- export
def cmd_export(args):
    con = connect(args)
    out = Path(args.out) if args.out else Path(args.root) / "data" / "export"
    if args.format in ("json", "both"):
        _export_json(con, out)
    if args.format in ("csv", "both"):
        _export_csv(con, out / "csv" if args.format == "both" else out)
    print(f"exported {args.format} -> {out}")


def _export_json(con, out: Path):
    cfg, ent = out / "config", out / "entities"
    for d in (cfg, ent):
        d.mkdir(parents=True, exist_ok=True)

    def dump(path, obj):
        path.write_text(json.dumps(obj, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")

    dump(cfg / "countries.json", {"schema_version": 1,
        "countries": [{"code": r["code"], "label": r["label"]} for r in con.execute("SELECT * FROM countries ORDER BY code")]})
    dump(cfg / "languages.json", {"schema_version": 1,
        "languages": [{"code": r["code"], "label": r["label"]} for r in con.execute("SELECT * FROM languages ORDER BY code")]})
    dump(cfg / "contact_channels.json", {"schema_version": 1,
        "contact_channels": [{"channel": r["channel"], "label": r["label"], "is_sensitive": r["is_sensitive"]}
                             for r in con.execute("SELECT * FROM contact_channels ORDER BY channel")]})
    dump(cfg / "tag_axes.json", {"schema_version": 1,
        "tag_axes": [{"axis": r["axis"], "label": r["label"], "review_status": r["review_status"]}
                     for r in con.execute("SELECT * FROM person_tag_axes ORDER BY axis")]})
    persons = [_person_obj(con, r["id"], with_memberships=False) for r in con.execute("SELECT id FROM persons ORDER BY id")]
    dump(ent / "persons.json", {"schema_version": 1, "persons": persons})
    memberships = []
    for r in con.execute("SELECT DISTINCT person_id FROM person_project_memberships ORDER BY person_id"):
        pid = r["person_id"]
        for m in _memberships_for(con, pid):
            memberships.append({"person_id": pid, **m})
    dump(ent / "memberships.json", {"schema_version": 1, "memberships": memberships})


def _export_csv(con, out: Path):
    out.mkdir(parents=True, exist_ok=True)

    def write(name, header, rows):
        with (out / name).open("w", newline="", encoding="utf-8") as fh:
            w = csv.writer(fh)
            w.writerow(header)
            for row in rows:
                w.writerow(row)

    write("persons.csv",
          ["id", "display_name", "kind", "status", "review_status", "residence_country", "preferred_language", "preferred_contact_channel", "timezone", "last_updated"],
          ([r["id"], r["display_name"], r["kind"], r["status"], r["review_status"], r["residence_country"], r["preferred_language"], r["preferred_contact_channel"], r["timezone"], r["last_updated"]]
           for r in con.execute("SELECT * FROM persons ORDER BY id")))
    write("aliases.csv", ["person_id", "alias", "is_primary"],
          ([r["person_id"], r["alias"], r["is_primary"]] for r in con.execute("SELECT * FROM person_aliases ORDER BY person_id, alias")))
    write("contacts.csv", ["person_id", "channel", "handle", "is_primary"],
          ([r["person_id"], r["channel"], r["handle"], r["is_primary"]] for r in con.execute("SELECT * FROM person_contacts ORDER BY person_id, channel")))
    write("languages.csv", ["person_id", "language", "proficiency", "is_primary"],
          ([r["person_id"], r["language"], r["proficiency"], r["is_primary"]] for r in con.execute("SELECT * FROM person_languages ORDER BY person_id, language")))
    write("nationalities.csv", ["person_id", "country", "is_primary"],
          ([r["person_id"], r["country"], r["is_primary"]] for r in con.execute("SELECT * FROM person_nationalities ORDER BY person_id, country")))
    write("tags.csv", ["person_id", "axis", "value"],
          ([r["person_id"], r["axis"], r["value"]] for r in con.execute("SELECT * FROM person_tags ORDER BY person_id, axis, value")))
    write("relationships.csv", ["from_person_id", "to_person_id", "type", "note"],
          ([r["from_person_id"], r["to_person_id"], r["type"], r["note"]] for r in con.execute("SELECT * FROM person_relationships ORDER BY from_person_id, to_person_id")))
    write("memberships.csv", ["person_id", "project_id", "status", "working_relationship", "can_merge", "can_deploy"],
          ([r["person_id"], r["project_id"], r["status"], r["working_relationship"], r["can_merge"], r["can_deploy"]]
           for r in con.execute("SELECT * FROM person_project_memberships ORDER BY person_id, project_id")))


# --------------------------------------------------------------------------- CLI
def build_parser():
    p = argparse.ArgumentParser(prog="pp", description="People registry engine (SQLite v1, stdlib).")
    p.add_argument("--root", default=str(DEFAULT_ROOT), help="workspace root (default: ~/Workspaces/Personal/People)")
    p.add_argument("--db", help="override DB path (default: <root>/data/people.db)")
    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("init"); s.add_argument("--force", action="store_true")
    s.add_argument("--seed", action="store_true", help="seed base lookups + sentinel"); s.set_defaults(func=cmd_init)

    s = sub.add_parser("migrate"); s.add_argument("--dry-run", action="store_true"); s.set_defaults(func=cmd_migrate)

    s = sub.add_parser("import-json")
    s.add_argument("--src", help="source mirror dir (default: <root>/data/export)")
    s.add_argument("--force", action="store_true"); s.set_defaults(func=cmd_import)

    s = sub.add_parser("export")
    s.add_argument("--format", choices=["json", "csv", "both"], default="json")
    s.add_argument("--out"); s.set_defaults(func=cmd_export)

    s = sub.add_parser("validate")
    s.add_argument("--budget-db", help="override budget DB path for the reverse cross-check (read-only)")
    s.set_defaults(func=cmd_validate)

    s = sub.add_parser("show"); s.add_argument("--id", required=True); s.set_defaults(func=cmd_show)
    s = sub.add_parser("list")
    s.add_argument("--status", choices=["active", "inactive"]); s.add_argument("--kind", choices=["self", "individual"])
    s.add_argument("--project"); s.set_defaults(func=cmd_list)
    s = sub.add_parser("search"); s.add_argument("query"); s.set_defaults(func=cmd_search)
    s = sub.add_parser("whois", help="resolve a handle/name -> person_id (+ context)"); s.add_argument("query"); s.set_defaults(func=cmd_whois)

    s = sub.add_parser("upsert-person")
    s.add_argument("--id"); s.add_argument("--name")
    s.add_argument("--kind", choices=["self", "individual"]); s.add_argument("--status", choices=["active", "inactive"])
    s.add_argument("--review-status", dest="review_status", choices=["needs_review", "confirmed", "ignored"])
    s.add_argument("--residence"); s.add_argument("--preferred-language", dest="preferred_language")
    s.add_argument("--preferred-contact-channel", dest="preferred_contact_channel"); s.add_argument("--timezone")
    s.add_argument("--last-updated", dest="last_updated")
    s.add_argument("--alias", action="append", default=[]); s.add_argument("--language", action="append", default=[])
    s.add_argument("--nationality", action="append", default=[]); s.set_defaults(func=cmd_upsert)

    s = sub.add_parser("set-status"); s.add_argument("--id", required=True)
    s.add_argument("--status", required=True, choices=["active", "inactive"]); s.set_defaults(func=cmd_set_status)

    s = sub.add_parser("review"); s.set_defaults(func=cmd_review)
    for name, fn in (("confirm", cmd_confirm), ("ignore", cmd_ignore)):
        s = sub.add_parser(name); s.add_argument("--id", required=True); s.set_defaults(func=fn)

    s = sub.add_parser("rename-person"); s.add_argument("--old", required=True); s.add_argument("--new", required=True); s.set_defaults(func=cmd_rename)
    s = sub.add_parser("merge-person"); s.add_argument("--old", required=True); s.add_argument("--into", required=True); s.set_defaults(func=cmd_merge)

    s = sub.add_parser("alias-add"); s.add_argument("--id", required=True); s.add_argument("--alias", required=True)
    s.add_argument("--primary", action="store_true"); s.set_defaults(func=cmd_alias_add)
    s = sub.add_parser("alias-rm"); s.add_argument("--id", required=True); s.add_argument("--alias", required=True); s.set_defaults(func=cmd_alias_rm)

    s = sub.add_parser("contact-set"); s.add_argument("--id", required=True); s.add_argument("--channel", required=True)
    s.add_argument("--handle", required=True); s.add_argument("--primary", action="store_true"); s.set_defaults(func=cmd_contact_set)
    s = sub.add_parser("contact-rm"); s.add_argument("--id", required=True); s.add_argument("--channel", required=True)
    s.add_argument("--handle"); s.set_defaults(func=cmd_contact_rm)

    s = sub.add_parser("lang-add"); s.add_argument("--id", required=True); s.add_argument("--language", required=True)
    s.add_argument("--proficiency", choices=["native", "fluent", "conversational", "basic"]); s.add_argument("--primary", action="store_true"); s.set_defaults(func=cmd_lang_add)
    s = sub.add_parser("lang-rm"); s.add_argument("--id", required=True); s.add_argument("--language", required=True); s.set_defaults(func=cmd_lang_rm)

    s = sub.add_parser("nat-add"); s.add_argument("--id", required=True); s.add_argument("--country", required=True)
    s.add_argument("--label"); s.add_argument("--primary", action="store_true"); s.set_defaults(func=cmd_nat_add)
    s = sub.add_parser("nat-rm"); s.add_argument("--id", required=True); s.add_argument("--country", required=True); s.set_defaults(func=cmd_nat_rm)

    s = sub.add_parser("note-add"); s.add_argument("--id", required=True); s.add_argument("--text", required=True); s.set_defaults(func=cmd_note_add)

    s = sub.add_parser("tag-set"); s.add_argument("--id", required=True); s.add_argument("--axis", required=True)
    s.add_argument("--value", required=True); s.add_argument("--label"); s.set_defaults(func=cmd_tag_set)
    s = sub.add_parser("tag-rm"); s.add_argument("--id", required=True); s.add_argument("--axis", required=True); s.add_argument("--value", required=True); s.set_defaults(func=cmd_tag_rm)

    s = sub.add_parser("rel-add"); s.add_argument("--from", dest="from_id", required=True); s.add_argument("--to", dest="to_id", required=True)
    s.add_argument("--type", required=True); s.add_argument("--note"); s.set_defaults(func=cmd_rel_add)
    s = sub.add_parser("rel-rm"); s.add_argument("--from", dest="from_id", required=True); s.add_argument("--to", dest="to_id", required=True)
    s.add_argument("--type", required=True); s.set_defaults(func=cmd_rel_rm)

    s = sub.add_parser("import-projects", help="rebuild membership mirror from Projects"); s.set_defaults(func=cmd_import_projects)

    s = sub.add_parser("backup"); s.add_argument("--out"); s.add_argument("--keep", type=int); s.set_defaults(func=cmd_backup)
    s = sub.add_parser("audit"); s.add_argument("--id"); s.add_argument("--limit", type=int); s.set_defaults(func=cmd_audit)
    return p


def main(argv=None):
    args = build_parser().parse_args(argv)
    args.func(args)


if __name__ == "__main__":
    main()
