def cmd_contact_set(args):
    con = connect(args)
    _need_person(con, args.id)
    con.execute("BEGIN")
    try:
        _ensure_channel(con, args.channel)
        ch = args.channel.strip().lower()
        hn = normalize_handle(args.handle)
        con.execute("INSERT OR REPLACE INTO person_contacts(person_id, channel, handle, handle_norm, is_primary) VALUES (?,?,?,?,?)",
                    (args.id, ch, args.handle, hn, 1 if args.primary else 0))
        if args.primary:
            con.execute("UPDATE person_contacts SET is_primary = 0 WHERE person_id = ? AND NOT (channel = ? AND handle_norm = ?)", (args.id, ch, hn))
        _audit(con, args.id, "contact", "person_contacts", ch, None, args.handle)
        con.execute("COMMIT")
    except Exception:
        con.execute("ROLLBACK"); raise
    print(json.dumps({"action": "contact-set", "id": args.id, "channel": args.channel}, ensure_ascii=False))


def cmd_contact_rm(args):
    con = connect(args)
    if args.handle:
        con.execute("DELETE FROM person_contacts WHERE person_id = ? AND channel = ? AND handle_norm = ?",
                    (args.id, args.channel.strip().lower(), normalize_handle(args.handle)))
    else:
        con.execute("DELETE FROM person_contacts WHERE person_id = ? AND channel = ?", (args.id, args.channel.strip().lower()))
    if con.total_changes == 0:
        die(f"no contact on channel {args.channel!r} for {args.id}")
    _audit(con, args.id, "contact-rm", "person_contacts", args.channel, None, None)
    print(json.dumps({"action": "contact-rm", "id": args.id, "channel": args.channel}, ensure_ascii=False))


