{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-claude-auth@latest",
    "@slkiser/opencode-quota"
  ],
  "instructions": [
    "instructions/*.txt",
    "instructions/*.md"
  ],
  "provider": {
    "openrouter": {
      "models": {
        "glm-5.2": {
          "name": "GLM-5.2",
          "variants": {
            "high": {
              "reasoningEffort": "high",
            },
            "max": {
              "reasoningEffort": "max",
            },
          }
        }
      }
    }
  },
  "agent": {
    "explore": {
      "hidden": true,
    },
    "general": {
      "hidden": true,
    },
  },
  "permission": {
    "edit": "ask",
    "bash": {
      "*": "ask",
      // Read / inspect (safe)
      "ls*": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "stat *": "allow",
      "file *": "allow",
      "du *": "allow",
      "df*": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "jq *": "allow",
      "pwd*": "allow",
      "which *": "allow",
      "whoami*": "allow",
      "uname*": "allow",
      "date*": "allow",
      "echo *": "allow",
      "printf *": "allow",
      "realpath *": "allow",
      "dirname *": "allow",
      "basename *": "allow",
      "sort *": "allow",
      "uniq *": "allow",
      "cut *": "allow",
      "tr *": "allow",
      "nl *": "allow",
      "column *": "allow",
      "diff *": "allow",
      "comm *": "allow",
      "tree*": "allow",
      "type *": "allow",
      "command -v*": "allow",
      "printenv *": "allow",
      "base64 *": "allow",
      "xxd *": "allow",
      "shasum *": "allow",
      "md5 *": "allow",
      "mkdir *": "allow",
      "touch *": "allow",
      "tac *": "allow",
      "rev *": "allow",
      "paste *": "allow",
      "join *": "allow",
      "fold *": "allow",
      "fmt *": "allow",
      "expand *": "allow",
      "unexpand *": "allow",
      "seq *": "allow",
      "expr *": "allow",
      "cmp *": "allow",
      "od *": "allow",
      "hexdump *": "allow",
      "strings *": "allow",
      "egrep *": "allow",
      "fgrep *": "allow",
      "gron *": "allow",
      "cksum *": "allow",
      "sha1sum *": "allow",
      "sha256sum *": "allow",
      "sha512sum *": "allow",
      // System / network info
      "id*": "allow",
      "groups*": "allow",
      "hostname*": "allow",
      "uptime*": "allow",
      "arch*": "allow",
      "nproc*": "allow",
      "sw_vers*": "allow",
      "getconf *": "allow",
      "locale*": "allow",
      "cal*": "allow",
      "ps *": "allow",
      "pgrep *": "allow",
      "dig *": "allow",
      "host *": "allow",
      "nslookup *": "allow",
      "netstat*": "allow",
      "ss *": "allow",
      "ifconfig*": "allow",
      "ip *": "allow",
      "arp *": "allow",
      "scutil --dns*": "allow",
      // Docs
      "man *": "allow",
      "whatis *": "allow",
      "apropos *": "allow",
      "tldr *": "allow",
      // Git (non-destructive: allow / destructive & history-rewrite: ask)
      "git *": "allow",
      "git push*": "ask",
      "git rebase*": "ask",
      "git reset*": "ask",
      "git checkout*": "ask",
      "git restore*": "ask",
      "git clean*": "ask",
      "git commit*": "ask",
      "git merge*": "ask",
      "git revert*": "ask",
      "git cherry-pick*": "ask",
      "git config*": "ask",
      // Build / test (runs project code)
      "npm *": "allow",
      "pnpm *": "allow",
      "yarn *": "allow",
      "bun *": "allow",
      "make *": "allow",
      "cargo *": "allow",
      "go *": "allow",
      "pytest*": "allow",
      "jest*": "allow",
      "vitest*": "allow",
      "gh *": "allow",
      // Re-gate network-fetch-and-run / value-exposing forms back to ask
      "npm exec*": "ask",
      "npm create*": "ask",
      "pnpm dlx*": "ask",
      "pnpm exec*": "ask",
      "pnpm create*": "ask",
      "yarn dlx*": "ask",
      "yarn create*": "ask",
      "bun x*": "ask",
      "cargo install*": "ask",
      "go install*": "ask",
      "gh auth*": "ask",
      "gh secret*": "ask",
      // Note: npx / bunx / pip / uv / docker / node / python / ruby / bash -c stay ask by default
      // Version checks (gated tools)
      "node --version*": "allow",
      "node -v*": "allow",
      "deno --version*": "allow",
      "python --version*": "allow",
      "python -V*": "allow",
      "python3 --version*": "allow",
      "python3 -V*": "allow",
      "pip --version*": "allow",
      "pip list*": "allow",
      "pip show *": "allow",
      "pip3 --version*": "allow",
      "pip3 list*": "allow",
      "ruby --version*": "allow",
      "perl --version*": "allow",
      "docker --version*": "allow",
      "kubectl version*": "allow",
      "terraform version*": "allow",
      "terraform --version*": "allow",
      // Heavy tools (read-only subcommands)
      "docker ps*": "allow",
      "docker images*": "allow",
      "docker image ls*": "allow",
      "docker logs*": "allow",
      "docker inspect*": "allow",
      "docker info*": "allow",
      "docker compose ls*": "allow",
      "docker compose ps*": "allow",
      "kubectl get*": "allow",
      "kubectl describe*": "allow",
      "kubectl logs*": "allow",
      "kubectl config view*": "allow",
      "kubectl top*": "allow",
      "kubectl explain*": "allow",
      "brew list*": "allow",
      "brew info*": "allow",
      "brew search*": "allow",
      "brew outdated*": "allow",
      "brew config*": "allow",
      "brew doctor*": "allow",
      "brew --version*": "allow",
      "terraform validate*": "allow",
      "terraform plan*": "allow",
      "terraform show*": "allow",
      "terraform output*": "allow",
      "terraform state list*": "allow",
      "terraform fmt -check*": "allow",
      // Agent Browser
      "agent-browser *": "allow",
      // Secret (read-only subcommands)
      "secret ls*": "allow",
      "secret list*": "allow",
      "secret show *": "allow",
      "secret projects*": "allow",
      "secret help*": "allow",
      "secret keychain ls*": "allow",
      "secret keychain master status*": "allow",
      // Deny block pinned last (not overridden by allows above)
      "sudo *": "deny",
      "wget *": "deny",
      "dd *": "deny",
      ":(){ :|:& }; *": "deny",
      "secret get*": "deny",
      "secret rm*": "deny",
      "secret del*": "deny",
      "secret export*": "deny",
      "secret import*": "deny",
      "secret keychain rm*": "deny",
      "secret keychain delete*": "deny",
      "secret keychain master set*": "deny",
      "secret keychain master rotate*": "deny",
      "secret keychain master forget*": "deny",
      "secret keychain master reveal*": "deny",
    },
    "skill": {
      "*": "ask",
      "customize-opencode": "allow",
      "keychain-secrets": "allow",
      "approach": "allow"
    },
  },
}
