    },
    {
      "action": "shell",
      "resource": "kubectl config view*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "kubectl config view --raw*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "kubectl top*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "kubectl explain*",
      "effect": "allow"
    },
    {
