{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    // Claude Pro/Max through OpenCode's own OAuth login (`opencode auth login
    // anthropic --method claude-max`), not Claude Code's Keychain entries, so
    // Hermes' account and Claude Code are never touched. Anthropic does not
    // permit subscription use outside Claude Code; this is an accepted risk.
    // Pinned: the 2.x line is a prerelease and tracks OpenCode 2's beta
    // plugin API. Bump deliberately and re-test a login and a refresh.
    "@ex-machina/opencode-anthropic-auth@2.0.0-next.5",
    // Usage limits in the TUI and /quota. Reads the Anthropic login above;
    // opencode-quota/quota-toast.jsonc keeps it off Claude Code's Keychain.
    "@slkiser/opencode-quota@5.0.1",
    // Outside auto-discovery's plugins/ directory. Keep this entry last, after
    // quota. enabled: false stops new selection but retains in-flight guards.
    {
      "package": "./lib/subagent-fallback",
      "options": {
        "enabled": true,
        "creditsLastResort": true,
        // A project's own agent file for a routed role (reviewer, verifier,
        // ...) loses its model to the route; its prompt and permissions stay.
        "pinModels": true,
        // Console credit lanes, in spending order (see the providers below).
        // Specialists try them before the subscription; the primary moves to
        // them when the subscription hits a window limit. [] turns it off.
        "creditLanes": [
          "anthropic-credit-main",
          "anthropic-credit-sub"
        ]
      }
    }
  ],
  // No "instructions" array: OpenCode V2 accepts it but never loads the files
  // (anomalyco/opencode#51341). All global rules live in AGENTS.md, which both
  // V1 and V2 read.
  // Anthropic's prompt cache lives five minutes, and a miss rewrites the whole
  // conversation (about $1 per rewrite at 380k tokens on Sonnet 5.5). A
  // keep-alive every four minutes holds it through pauses of up to twenty
  // minutes; the longest pause measured in one long session was sixteen. It is
  // a real request on every provider, the subscription included: each one costs
  // a cache read (a tenth of the input price), at most four per idle window.
  "warming": {
    "interval": "4 minutes",
    "duration": "20 minutes"
  },
  // OpenCode 2 formats nothing unless a config sets "formatter"; the object
  // form also enables the built-ins whose tools are installed.
  "formatter": {
    // Markdown runs the Prettier that Mason installs for nvim, resolved like
    // stdpath("data"), so both editors format it the same way without
    // project config. A project's own Prettier dependency still wins. Like
    // nvim, it starts in the nearest directory holding a .prettierignore,
    // the only place Prettier reads one, even for files in another repo.
    // Symlinks are resolved first, so a file reached through the Hermes or
    // private overlay follows the ignore file of the repo it lives in.
    "prettier-markdown": {
      "command": [
        "sh",
        "-c",
        "f=$(realpath \"$1\" 2>/dev/null) || f=$1; d=$(dirname \"$f\"); until [ -e \"$d/.prettierignore\" ] || [ \"$d\" = / ]; do d=$(dirname \"$d\"); done; [ -e \"$d/.prettierignore\" ] && cd \"$d\"; exec \"${XDG_DATA_HOME:-$HOME/.local/share}/nvim/mason/bin/prettier\" --write \"$f\"",
        "sh",
        "$FILE",
      ],
      "extensions": [
        ".md",
        ".mdx"
      ],
    },
    // nvim does not format Python on save, and most Python here is not
    // ruff-formatted: every edit would rewrite the whole file.
    "uv": {
      "disabled": true
    },
    "ruff": {
      "disabled": true
    },
  },
  // Caps tool results before they enter the conversation, so past turns
  // never change and the prompt cache stays intact. On 2.0.23 it reaches
  // shell (keeps the tail) and webfetch/websearch (keep the head) only;
  // read pages at its own fixed 50 KiB and grep/glob have their own result
  // limits. The full text is saved and its path shown to the model. In the
  // first two days it cut 0.8% of tool calls, the model re-read few of
  // them, and it saved well under 1% of cache reads, so lowering it further
  // is not worth it until read honors the cap too.
  "tool_output": {
    "max_lines": 1000,
    "max_bytes": 36864,
  },
  // New worktrees: plugins/worktrees.ts places them at
  // ~/Worktrees/<repository>/<branch> on a new branch from the fetched remote
  // default branch, like the Hermes workspace; this parent is what OpenCode
  // suggests (and creates) before calling it.
  "worktree": {
    "directory": "~/Worktrees"
  },
  "agents": {
    "plan": {
      "color": "#f5f5f5",
      "model": "anthropic/claude-opus-5-5#high",
      // Global edit: ask overrides the built-in deny. Restore Plan's boundary
      // here, and allow only read-only specialists. Verifier can apply a
      // formatter and worker/general can edit, so none belongs in Plan.
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "edit",
          "resource": "~/.opencode/plan/*",
          "effect": "allow"
        },
        {
          "action": "git_commit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "git_worktree",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "explore*",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "searcher*",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "debugger",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "reviewer",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "reviewer-deep",
          "effect": "allow"
        },
      ],
    },
    "build": {
      "color": "#ff6f00",
      "model": "anthropic/claude-opus-5-5#medium",
    },
    "explore": {
      // Global edit: ask must not turn read-only exploration into editing.
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "git_commit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "git_worktree",
          "resource": "*",
          "effect": "deny"
        },
      ],
    },
    "review": {
      "color": "#A855F7",
    },
    "debug": {
      "color": "#06B6D4",
    },
    "compaction": {
      // Trial: revert to claude-sonnet-5-5 (medium) if summaries drop key facts.
      "model": "anthropic/claude-haiku-5-5#medium",
    },
    // Session titles (V1 small_model).
    "title": {
      "model": "openai/gpt-6-luna",
    },
  },
  "providers": {
    "openai": {
      "models": {
        // OpenAI API list prices (USD per 1M tokens), used only for OpenCode's
        // cost estimates. Source: https://developers.openai.com/api/docs/pricing
        // A second entry with a context tier applies above 200k tokens.
        "gpt-6-astra": {
          "cost": [
            {
              "input": 10,
              "output": 50,
              "cache": {
                "read": 1
              }
            },
            {
              "tier": {
                "type": "context",
                "size": 200000
              },
              "input": 20,
              "output": 75,
              "cache": {
                "read": 2
              },
            },
          ],
        },
        "gpt-6-sol": {
          "cost": [
            {
              "input": 2,
              "output": 10,
              "cache": {
                "read": 0.2
              }
            },
            {
              "tier": {
                "type": "context",
                "size": 200000
              },
              "input": 4,
              "output": 15,
              "cache": {
                "read": 0.4
              },
            },
          ],
        },
        "gpt-6.1-sol": {
          "cost": [
            {
              "input": 2,
              "output": 10,
              "cache": {
                "read": 0.1
              }
            }
          ],
        },
        "gpt-6-luna": {
          "cost": [
            {
              "input": 0.1,
              "output": 0.5,
              "cache": {
                "read": 0.01
              }
            },
            {
              "tier": {
                "type": "context",
                "size": 200000
              },
              "input": 0.2,
              "output": 0.75,
              "cache": {
                "read": 0.02
              },
            },
          ],
        },
        // Spark has no separate public API pricing table; use the published
        // gpt-5.3-codex rate so OpenCode cost estimates are not unknown.
        "gpt-5.3-codex-spark": {
          "cost": [
            {
              "input": 1.75,
              "output": 14,
              "cache": {
                "read": 0.175
              }
            }
          ],
        },
      },
    },
    // Console credit lanes: the monthly API credits that Max plans grant, one
    // Console org per plan. They cannot be used by Claude Code or as extra
    // usage, only through an API key. Keys come from the Keychain project
    // `opencode` (never named ANTHROPIC_API_KEY, which would override the
    // OAuth login), and a lane stays inactive while its variable is unset. No
    // payment method or auto-reload on either org, so an empty balance fails
    // instead of billing. canonical inherits the anthropic catalog: models,
    // limits and list prices.
    "anthropic-credit-main": {
      "name": "Anthropic Main Credit",
      "canonical": "anthropic",
      "package": "@opencode/ai/providers/anthropic",
      "env": [
        "ANTHROPIC_CREDIT_MAIN_ACCOUNT_KEY"
      ],
      "models": {
        "claude-fable-5-1": {},
        "claude-opus-5-5": {},
        "claude-sonnet-5-5": {},
        "claude-haiku-5-5": {},
      },
    },
    "anthropic-credit-sub": {
      "name": "Anthropic Sub Credit",
      "canonical": "anthropic",
      "package": "@opencode/ai/providers/anthropic",
      "env": [
        "ANTHROPIC_CREDIT_SUB_ACCOUNT_KEY"
      ],
      "models": {
        "claude-fable-5-1": {},
        "claude-opus-5-5": {},
        "claude-sonnet-5-5": {},
        "claude-haiku-5-5": {},
      },
    },
  },
  "permissions": [
    {
      "action": "edit",
      "resource": "*",
      "effect": "ask"
    },
    // Skill supporting files (references/, assets/, scripts/). OpenCode 1
    // allowed every skill directory on its own; OpenCode 2 asks for each one.
    {
      "action": "external_directory",
      "resource": "~/.agents/skills/*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/.claude/skills/*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/.config/opencode/skills/*",
      "effect": "allow"
    },
    // .env may hold secrets — gate whole-file reads via the Read tool too
    // (bash cat/head/tail on .env is already denied below). Last match wins:
    // example/sample templates stay free. `*` also matches `/`, and a file at
    // the Location root has no directory part, so `**/.env` would miss it.
    {
      "action": "read",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "*.env",
      "effect": "ask"
    },
    {
      "action": "read",
      "resource": ".env.*",
      "effect": "ask"
    },
    {
      "action": "read",
      "resource": "*/.env.*",
      "effect": "ask"
    },
    {
      "action": "read",
      "resource": "*.env.example",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "*.env.sample",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "ask"
    },
    // Read / inspect (safe)
    {
      "action": "shell",
      "resource": "ls*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "cat *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "head *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "tail *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "tail -f*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "tail -F*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "wc *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "stat *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "file *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "du *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "df*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "grep *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "rg *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "jq *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "pwd*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "which *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "whoami*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "uname*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "date*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "echo *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "printf *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "realpath *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "dirname *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "basename *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "sort *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "uniq *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "cut *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "tr *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "nl *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "column *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "diff *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "comm *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "tree*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "type *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "command -v*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "base64 *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "xxd *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "shasum *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "md5 *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "mkdir *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "touch *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "tac *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "rev *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "paste *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "join *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "fold *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "fmt *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "expand *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "unexpand *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "seq *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "expr *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "cmp *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "od *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "hexdump *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "strings *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "egrep *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "fgrep *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "gron *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "cksum *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "sha1sum *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "sha256sum *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "sha512sum *",
      "effect": "allow"
    },
    // System / network info
    {
      "action": "shell",
      "resource": "id*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "groups*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "hostname*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "uptime*",
      "effect": "allow"
    },
    // Bare `arch` only: `arch -arm64 <cmd>` runs any command.
    {
      "action": "shell",
      "resource": "arch",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "nproc*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "sw_vers*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "getconf *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "locale*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "cal*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "ps *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "pgrep *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "dig *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "host *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "nslookup *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "netstat*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "ss *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "ifconfig*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "ip *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "arp *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "scutil --dns*",
      "effect": "allow"
    },
    // Docs
    {
      "action": "shell",
      "resource": "man *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "whatis *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "apropos *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "tldr *",
      "effect": "allow"
    },
    // Git (non-destructive: allow / destructive & history-rewrite: ask)
    {
      "action": "shell",
      "resource": "git *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git push*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git rebase*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git reset*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git checkout*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git restore*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git clean*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git commit*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git merge*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git revert*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git cherry-pick*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git config*",
      "effect": "ask"
    },
    // Safe local commits (message-bearing) bypass the gate; bare `git commit` stays ask
    {
      "action": "shell",
      "resource": "git commit -m*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git commit --message*",
      "effect": "allow"
    },
    // Re-gate risky flags in ANY position (last match wins over the -m allows above)
    {
      "action": "shell",
      "resource": "git commit*--amend*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git commit*--no-verify*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git commit*--fixup*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git commit*--squash*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git commit*--all*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git commit* -a*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git commit* -n*",
      "effect": "ask"
    },
    // Build / test (runs project code)
    {
      "action": "shell",
      "resource": "npm *",
      "effect": "allow"
