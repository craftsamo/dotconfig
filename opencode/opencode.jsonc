{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-claude-auth@latest",
    "@slkiser/opencode-quota"
  ],
  "instructions": [
    "instructions/*.txt",
    "instructions/*.md"
  ],
  "provider": {
    "zai-coding-plan": {
      "models": {
        // OpenCode currently exposes no variants for these non-5.2 GLM
        // reasoning models, even though Z.AI supports thinking on/off.
        "glm-4.5-air": {
          "cost": {
            "input": 0.2,
            "output": 1.1,
            "cache_read": 0.03,
            "cache_write": 0
          },
          "variants": {
            "none": {
              "thinking": {
                "type": "disabled"
              }
            },
            "thinking": {
              "thinking": {
                "type": "enabled",
                "clear_thinking": false
              }
            }
          }
        },
        "glm-4.7": {
          "cost": {
            "input": 0.6,
            "output": 2.2,
            "cache_read": 0.11,
            "cache_write": 0
          },
          "variants": {
            "none": {
              "thinking": {
                "type": "disabled"
              }
            },
            "thinking": {
              "thinking": {
                "type": "enabled",
                "clear_thinking": false
              }
            }
          }
        },
        "glm-5.1": {
          "cost": {
            "input": 1.4,
            "output": 4.4,
            "cache_read": 0.26,
            "cache_write": 0
          },
          "variants": {
            "none": {
              "thinking": {
                "type": "disabled"
              }
            },
            "thinking": {
              "thinking": {
                "type": "enabled",
                "clear_thinking": false
              }
            }
          }
        },
        "glm-5-turbo": {
          "cost": {
            "input": 1.2,
            "output": 4.0,
            "cache_read": 0.24,
            "cache_write": 0
          },
          "variants": {
            "none": {
              "thinking": {
                "type": "disabled"
              }
            },
            "thinking": {
              "thinking": {
                "type": "enabled",
                "clear_thinking": false
              }
            }
          }
        },
        "glm-5.2": {
          "cost": {
            "input": 1.4,
            "output": 4.4,
            "cache_read": 0.26,
            "cache_write": 0
          }
        },
        // Listed by OpenCode/models.dev, but your Pro probe returned 1311.
        "glm-5v-turbo": {
          "cost": {
            "input": 1.2,
            "output": 4.0,
            "cache_read": 0.24,
            "cache_write": 0
          }
        },
        // Extra GLM Coding Plan models verified against the endpoint but not yet
        // present in OpenCode/models.dev's zai-coding-plan catalog.
        "glm-4.5": {
          "id": "glm-4.5",
          "name": "GLM-4.5",
          "family": "glm",
          "attachment": false,
          "reasoning": true,
          "temperature": true,
          "tool_call": true,
          "release_date": "2025-07-28",
          "cost": {
            "input": 0.6,
            "output": 2.2,
            "cache_read": 0.11,
            "cache_write": 0
          },
          "limit": {
            "context": 131072,
            "output": 98304
          },
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "none": {
              "thinking": {
                "type": "disabled"
              }
            },
            "thinking": {
              "thinking": {
                "type": "enabled",
                "clear_thinking": false
              }
            }
          }
        },
        "glm-4.5-flash": {
          "id": "glm-4.5-flash",
          "name": "GLM-4.5-Flash",
          "family": "glm-flash",
          "attachment": false,
          "reasoning": true,
          "temperature": true,
          "tool_call": true,
          "release_date": "2025-07-28",
          "cost": {
            "input": 0,
            "output": 0,
            "cache_read": 0,
            "cache_write": 0
          },
          "limit": {
            "context": 131072,
            "output": 98304
          },
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "none": {
              "thinking": {
                "type": "disabled"
              }
            },
            "thinking": {
              "thinking": {
                "type": "enabled",
                "clear_thinking": false
              }
            }
          }
        },
        "glm-4.5v": {
          "id": "glm-4.5v",
          "name": "GLM-4.5V",
          "family": "glm",
          "attachment": true,
          "reasoning": true,
          "temperature": true,
          "tool_call": true,
          "release_date": "2025-08-11",
          "cost": {
            "input": 0.6,
            "output": 1.8,
            "cache_read": 0.11,
            "cache_write": 0
          },
          "limit": {
            "context": 64000,
            "output": 16384
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "video"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "none": {
              "thinking": {
                "type": "disabled"
              }
            },
            "thinking": {
              "thinking": {
                "type": "enabled",
                "clear_thinking": false
              }
            }
          }
        },
        "glm-4.6v": {
          "id": "glm-4.6v",
          "name": "GLM-4.6V",
          "family": "glm",
          "attachment": true,
          "reasoning": true,
          "temperature": true,
          "tool_call": true,
          "interleaved": {
            "field": "reasoning_content"
          },
          "release_date": "2025-12-08",
          "cost": {
            "input": 0.3,
            "output": 0.9,
            "cache_read": 0.05,
            "cache_write": 0
          },
          "limit": {
            "context": 128000,
            "output": 32768
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "video",
              "pdf"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "none": {
              "thinking": {
                "type": "disabled"
              }
            },
            "thinking": {
              "thinking": {
                "type": "enabled",
                "clear_thinking": false
              }
            }
          }
        },
        // Your probe returned a temporary overload (1305), not a plan/permission
        // rejection, so keep this available for retrying when capacity recovers.
        "glm-4.6v-flash": {
          "id": "glm-4.6v-flash",
          "name": "GLM-4.6V-Flash",
          "family": "glm-flash",
          "attachment": true,
          "reasoning": true,
          "temperature": true,
          "tool_call": true,
          "interleaved": {
            "field": "reasoning_content"
          },
          "release_date": "2025-12-08",
          "cost": {
            "input": 0,
            "output": 0,
            "cache_read": 0,
            "cache_write": 0
          },
          "limit": {
            "context": 128000,
            "output": 32768
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "video",
              "pdf"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "none": {
              "thinking": {
                "type": "disabled"
              }
            },
            "thinking": {
              "thinking": {
                "type": "enabled",
                "clear_thinking": false
              }
            }
          }
        }
      }
    }
  },
  "agent": {
    "explore": {
      "hidden": true,
    },
    "explore-small": {
      "mode": "subagent",
      "model": "zai-coding-plan/glm-5-turbo",
      "hidden": true,
      "description": "Fast/cheap read-only codebase lookups: find files, simple keyword search.",
      "permission": {
        "edit": "deny"
      },
    },
    "explore-high": {
      "mode": "subagent",
      "model": "zai-coding-plan/glm-5.2",
      "reasoningEffort": "high",
      "hidden": true,
      "description": "Read-only codebase exploration for hard or ambiguous questions.",
      "permission": {
        "edit": "deny"
      },
    },
    "explore-max": {
      "mode": "subagent",
      "model": "zai-coding-plan/glm-5.2",
      "reasoningEffort": "max",
      "hidden": true,
      "description": "Read-only codebase exploration for the hardest cases; deep step-by-step reasoning.",
      "permission": {
        "edit": "deny"
      },
    },
    "general": {
      "hidden": true,
    },
  },
  "permission": {
    "edit": "ask",
    "bash": {
      "*": "ask",
      // Read / inspect (safe)
      "ls*": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "tail -f*": "ask",
      "tail -F*": "ask",
      "wc *": "allow",
      "stat *": "allow",
      "file *": "allow",
      "du *": "allow",
      "df*": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "jq *": "allow",
      "pwd*": "allow",
      "which *": "allow",
      "whoami*": "allow",
      "uname*": "allow",
      "date*": "allow",
      "echo *": "allow",
      "printf *": "allow",
      "realpath *": "allow",
      "dirname *": "allow",
      "basename *": "allow",
      "sort *": "allow",
      "uniq *": "allow",
      "cut *": "allow",
      "tr *": "allow",
      "nl *": "allow",
      "column *": "allow",
      "diff *": "allow",
      "comm *": "allow",
      "tree*": "allow",
      "type *": "allow",
      "command -v*": "allow",
      "printenv *": "allow",
      "base64 *": "allow",
      "xxd *": "allow",
      "shasum *": "allow",
      "md5 *": "allow",
      "mkdir *": "allow",
      "touch *": "allow",
      "tac *": "allow",
      "rev *": "allow",
      "paste *": "allow",
      "join *": "allow",
      "fold *": "allow",
      "fmt *": "allow",
      "expand *": "allow",
      "unexpand *": "allow",
      "seq *": "allow",
      "expr *": "allow",
      "cmp *": "allow",
      "od *": "allow",
      "hexdump *": "allow",
      "strings *": "allow",
      "egrep *": "allow",
      "fgrep *": "allow",
      "gron *": "allow",
      "cksum *": "allow",
      "sha1sum *": "allow",
      "sha256sum *": "allow",
      "sha512sum *": "allow",
      // System / network info
      "id*": "allow",
      "groups*": "allow",
      "hostname*": "allow",
      "uptime*": "allow",
      "arch*": "allow",
      "nproc*": "allow",
      "sw_vers*": "allow",
      "getconf *": "allow",
      "locale*": "allow",
      "cal*": "allow",
      "ps *": "allow",
      "pgrep *": "allow",
      "dig *": "allow",
      "host *": "allow",
      "nslookup *": "allow",
      "netstat*": "allow",
      "ss *": "allow",
      "ifconfig*": "allow",
      "ip *": "allow",
      "arp *": "allow",
      "scutil --dns*": "allow",
      // Docs
      "man *": "allow",
      "whatis *": "allow",
      "apropos *": "allow",
      "tldr *": "allow",
      // Git (non-destructive: allow / destructive & history-rewrite: ask)
      "git *": "allow",
      "git push*": "ask",
      "git rebase*": "ask",
      "git reset*": "ask",
      "git checkout*": "ask",
      "git restore*": "ask",
      "git clean*": "ask",
      "git commit*": "ask",
      "git merge*": "ask",
      "git revert*": "ask",
      "git cherry-pick*": "ask",
      "git config*": "ask",
      // Safe local commits (message-bearing) bypass the gate; bare/-a/--amend/--fixup/--no-verify stay ask
      "git commit -m*": "allow",
      "git commit --message*": "allow",
      // Build / test (runs project code)
      "npm *": "allow",
      "pnpm *": "allow",
      "yarn *": "allow",
      "bun *": "allow",
      "make *": "allow",
      "cargo *": "allow",
      "go *": "allow",
      "pytest*": "allow",
      "jest*": "allow",
      "vitest*": "allow",
      "gh *": "allow",
      // Re-gate network-fetch-and-run / value-exposing forms back to ask
      "npm exec*": "ask",
      "npm create*": "ask",
      "pnpm dlx*": "ask",
      "pnpm exec*": "ask",
      "pnpm create*": "ask",
      "yarn dlx*": "ask",
      "yarn create*": "ask",
      "bun x*": "ask",
      "cargo install*": "ask",
      "go install*": "ask",
      "gh auth*": "ask",
      "gh secret*": "ask",
      // PR create/edit/view/ready stay allow; only merging is gated
      "gh pr merge*": "ask",
      "gh project delete*": "ask",
      "gh project field-delete*": "ask",
      "gh project item-delete*": "ask",
      // Note: npx / bunx / pip / uv / docker / node / python / ruby / bash -c stay ask by default
      // Version checks (gated tools)
      "node --version*": "allow",
      "node -v*": "allow",
      "deno --version*": "allow",
      "python --version*": "allow",
      "python -V*": "allow",
      "python3 --version*": "allow",
      "python3 -V*": "allow",
      "pip --version*": "allow",
      "pip list*": "allow",
      "pip show *": "allow",
      "pip3 --version*": "allow",
      "pip3 list*": "allow",
      "ruby --version*": "allow",
      "perl --version*": "allow",
      "docker --version*": "allow",
      "kubectl version*": "allow",
      "terraform version*": "allow",
      "terraform --version*": "allow",
      // Heavy tools (read-only subcommands)
      "docker ps*": "allow",
      "docker images*": "allow",
      "docker image ls*": "allow",
      "docker logs*": "allow",
      "docker logs -f*": "ask",
      "docker logs --follow*": "ask",
      "docker inspect*": "allow",
      "docker info*": "allow",
      "docker compose ls*": "allow",
      "docker compose ps*": "allow",
      "kubectl get*": "allow",
      "kubectl describe*": "allow",
      "kubectl logs*": "allow",
      "kubectl logs -f*": "ask",
      "kubectl logs --follow*": "ask",
      "kubectl config view*": "allow",
      "kubectl config view --raw*": "ask",
      "kubectl top*": "allow",
      "kubectl explain*": "allow",
      "brew list*": "allow",
      "brew info*": "allow",
      "brew search*": "allow",
      "brew outdated*": "allow",
      "brew config*": "allow",
      "brew doctor*": "allow",
      "brew --version*": "allow",
      "terraform validate*": "allow",
      "terraform plan*": "allow",
      "terraform show*": "allow",
      "terraform output*": "allow",
      "terraform state list*": "allow",
      "terraform fmt -check*": "allow",
      // Agent Browser
      "agent-browser *": "allow",
      // Secret (read-only subcommands)
      "secret ls*": "allow",
      "secret list*": "allow",
      "secret show *": "allow",
      "secret projects*": "allow",
      "secret help*": "allow",
      "secret keychain ls*": "allow",
      "secret keychain master status*": "allow",
      // Deny block pinned last (not overridden by allows above)
      "sudo *": "deny",
      "wget *": "deny",
      "dd *": "deny",
      "mkfs*": "deny",
      "shutdown*": "deny",
      "reboot*": "deny",
      "halt*": "deny",
      "diskutil erase*": "deny",
      ":(){ :|:& }; *": "deny",
      // Block reading .env via bash (best-effort)
      "cat *.env": "deny",
      "head *.env": "deny",
      "tail *.env": "deny",
      "cat *.env.*": "deny",
      // Secret: destructive / value-exposing
      "secret get*": "deny",
      "secret rm*": "deny",
      "secret del*": "deny",
      "secret export*": "deny",
      "secret import*": "deny",
      "secret keychain rm*": "deny",
      "secret keychain delete*": "deny",
      "secret keychain master set*": "deny",
      "secret keychain master rotate*": "deny",
      "secret keychain master forget*": "deny",
      "secret keychain master reveal*": "deny",
    },
    "skill": {
      "*": "ask",
      "customize-opencode": "allow",
      "keychain-secrets": "allow",
      "approach*": "allow",
      "resolve-dependabot-alerts": "allow",
      "manage-github-projects": "allow",
      "git-*": "allow"
    },
    // Custom GitHub Project tools (tools/github_project.ts) — board ops only, no delete
    "github_project_create": "allow",
    "github_project_field_ensure": "allow",
    "github_project_item_add": "allow",
    "github_project_item_set": "allow",
    "github_project_item_list": "allow",
    "github_project_item_note": "allow",
    "github_project_item_promote": "allow",
    "github_project_view_ensure": "allow",
    // Custom git workflow tools (tools/git.ts) — read/index only, no commit/push/merge
    "git_secret_scan": "allow",
    "git_stage_hunks": "allow",
    "git_provenance": "allow",
    "git_related_scan": "allow",
    "git_history_digest": "allow",
    "git_amend_check": "allow",
    "git_commit_lint": "allow",
  },
}
