{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-claude-auth@latest",
    "@slkiser/opencode-quota@3.11.1"
  ],
  "instructions": [
    "instructions/*.txt",
    "instructions/*.md"
  ],
  // Title generation etc. → light OpenAI Pro model without priority-tier cost.
  "small_model": "openai/gpt-5.4-mini",
  "agent": {
    "plan": {
      "color": "#f5f5f5",
    },
    "build": {
      "color": "#ff6f00",
    },
    "review": {
      "color": "#A855F7",
    },
    "debug": {
      "color": "#06B6D4",
    },
    "explain": {
      "color": "#10B981",
    },
    // Context compaction fires on every long session; keep it off the
    // Claude Max window but on a model strong enough to preserve context.
    "compaction": {
      "model": "openai/gpt-5.6-terra",
      "variant": "medium",
    },
  },
  "provider": {
    "openai": {
      "models": {
        // OpenAI API pricing, USD per 1M tokens. Source: https://developers.openai.com/api/docs/pricing
        // GPT-5.6 tiers. Pro mode bills at the selected tier's standard rate;
        // OpenCode's gpt-5.6-pro alias resolves to Sol Pro.
        "gpt-5.6-sol": {
          "cost": {
            "input": 5,
            "cache_read": 0.5,
            "output": 30,
            "context_over_200k": {
              "input": 10,
              "cache_read": 1,
              "output": 45,
            },
          },
        },
        "gpt-5.6-terra": {
          "cost": {
            "input": 2.5,
            "cache_read": 0.25,
            "output": 15,
            "context_over_200k": {
              "input": 5,
              "cache_read": 0.5,
              "output": 22.5,
            },
          },
        },
        "gpt-5.6-luna": {
          "cost": {
            "input": 1,
            "cache_read": 0.1,
            "output": 6,
            "context_over_200k": {
              "input": 2,
              "cache_read": 0.2,
              "output": 9,
            },
          },
        },
        // Spark has no separate public API pricing table; use the published
        // gpt-5.3-codex rate so OpenCode cost estimates are not unknown.
        "gpt-5.3-codex-spark": {
          "cost": {
            "input": 1.75,
            "cache_read": 0.175,
            "output": 14,
          },
        },
      },
    },
  },
  "permission": {
    "edit": "ask",
    "bash": {
      "*": "ask",
      // Read / inspect (safe)
      "ls*": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "tail -f*": "ask",
      "tail -F*": "ask",
      "wc *": "allow",
      "stat *": "allow",
      "file *": "allow",
      "du *": "allow",
      "df*": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "jq *": "allow",
      "pwd*": "allow",
      "which *": "allow",
      "whoami*": "allow",
      "uname*": "allow",
      "date*": "allow",
      "echo *": "allow",
      "printf *": "allow",
      "realpath *": "allow",
      "dirname *": "allow",
      "basename *": "allow",
      "sort *": "allow",
      "uniq *": "allow",
      "cut *": "allow",
      "tr *": "allow",
      "nl *": "allow",
      "column *": "allow",
      "diff *": "allow",
      "comm *": "allow",
      "tree*": "allow",
      "type *": "allow",
      "command -v*": "allow",
      "printenv *": "allow",
      "base64 *": "allow",
      "xxd *": "allow",
      "shasum *": "allow",
      "md5 *": "allow",
      "mkdir *": "allow",
      "touch *": "allow",
      "tac *": "allow",
      "rev *": "allow",
      "paste *": "allow",
      "join *": "allow",
      "fold *": "allow",
      "fmt *": "allow",
      "expand *": "allow",
      "unexpand *": "allow",
      "seq *": "allow",
      "expr *": "allow",
      "cmp *": "allow",
      "od *": "allow",
      "hexdump *": "allow",
      "strings *": "allow",
      "egrep *": "allow",
      "fgrep *": "allow",
      "gron *": "allow",
      "cksum *": "allow",
      "sha1sum *": "allow",
      "sha256sum *": "allow",
      "sha512sum *": "allow",
      // System / network info
      "id*": "allow",
      "groups*": "allow",
      "hostname*": "allow",
      "uptime*": "allow",
      "arch*": "allow",
      "nproc*": "allow",
      "sw_vers*": "allow",
      "getconf *": "allow",
      "locale*": "allow",
      "cal*": "allow",
      "ps *": "allow",
      "pgrep *": "allow",
      "dig *": "allow",
      "host *": "allow",
      "nslookup *": "allow",
      "netstat*": "allow",
      "ss *": "allow",
      "ifconfig*": "allow",
      "ip *": "allow",
      "arp *": "allow",
      "scutil --dns*": "allow",
      // Docs
      "man *": "allow",
      "whatis *": "allow",
      "apropos *": "allow",
      "tldr *": "allow",
      // Git (non-destructive: allow / destructive & history-rewrite: ask)
      "git *": "allow",
      "git push*": "ask",
      "git rebase*": "ask",
      "git reset*": "ask",
      "git checkout*": "ask",
      "git restore*": "ask",
      "git clean*": "ask",
      "git commit*": "ask",
      "git merge*": "ask",
      "git revert*": "ask",
      "git cherry-pick*": "ask",
      "git config*": "ask",
      // Safe local commits (message-bearing) bypass the gate; bare `git commit` stays ask
      "git commit -m*": "allow",
      "git commit --message*": "allow",
      // Re-gate risky flags in ANY position (last match wins over the -m allows above)
      "git commit*--amend*": "ask",
      "git commit*--no-verify*": "ask",
      "git commit*--fixup*": "ask",
      "git commit*--squash*": "ask",
      "git commit*--all*": "ask",
      "git commit* -a*": "ask",
      "git commit* -n*": "ask",
      // Build / test (runs project code)
      "npm *": "allow",
      "pnpm *": "allow",
      "yarn *": "allow",
      "bun *": "allow",
      "make *": "allow",
      "cargo *": "allow",
      "go *": "allow",
      "pytest*": "allow",
      "jest*": "allow",
      "vitest*": "allow",
      "gh *": "allow",
      // Re-gate network-fetch-and-run / value-exposing forms back to ask
      "npm exec*": "ask",
      "npm create*": "ask",
      "pnpm dlx*": "ask",
      "pnpm exec*": "ask",
      "pnpm create*": "ask",
      "yarn dlx*": "ask",
      "yarn create*": "ask",
      "bun x*": "ask",
      "cargo install*": "ask",
      "go install*": "ask",
      "gh auth*": "ask",
      "gh secret*": "ask",
      // PR create/edit/view/ready stay allow; only merging is gated
      "gh pr merge*": "ask",
      "gh project delete*": "ask",
      "gh project field-delete*": "ask",
      "gh project item-delete*": "ask",
      // Note: npx / bunx / pip / uv / docker / node / python / ruby / bash -c stay ask by default
      // Version checks (gated tools)
      "node --version*": "allow",
      "node -v*": "allow",
      "deno --version*": "allow",
      "python --version*": "allow",
      "python -V*": "allow",
      "python3 --version*": "allow",
      "python3 -V*": "allow",
      "pip --version*": "allow",
      "pip list*": "allow",
      "pip show *": "allow",
      "pip3 --version*": "allow",
      "pip3 list*": "allow",
      "ruby --version*": "allow",
      "perl --version*": "allow",
      "docker --version*": "allow",
      "kubectl version*": "allow",
      "terraform version*": "allow",
      "terraform --version*": "allow",
      // Heavy tools (read-only subcommands)
      "docker ps*": "allow",
      "docker images*": "allow",
      "docker image ls*": "allow",
      "docker logs*": "allow",
      "docker logs -f*": "ask",
      "docker logs --follow*": "ask",
      "docker inspect*": "allow",
      "docker info*": "allow",
      "docker compose ls*": "allow",
      "docker compose ps*": "allow",
      "kubectl get*": "allow",
      "kubectl describe*": "allow",
      "kubectl logs*": "allow",
      "kubectl logs -f*": "ask",
      "kubectl logs --follow*": "ask",
      "kubectl config view*": "allow",
      "kubectl config view --raw*": "ask",
      "kubectl top*": "allow",
      "kubectl explain*": "allow",
      "brew list*": "allow",
      "brew info*": "allow",
      "brew search*": "allow",
      "brew outdated*": "allow",
      "brew config*": "allow",
      "brew doctor*": "allow",
      "brew --version*": "allow",
      "terraform validate*": "allow",
      "terraform plan*": "allow",
      "terraform show*": "allow",
      "terraform output*": "allow",
      "terraform state list*": "allow",
      "terraform fmt -check*": "allow",
      // Agent Browser
      "agent-browser *": "allow",
      // Secret (read-only subcommands)
      "secret ls*": "allow",
      "secret list*": "allow",
      "secret show *": "allow",
      "secret projects*": "allow",
      "secret help*": "allow",
      "secret keychain ls*": "allow",
      "secret keychain master status*": "allow",
      // Deny block pinned last (not overridden by allows above)
      "sudo *": "deny",
      "wget *": "deny",
      "dd *": "deny",
      "mkfs*": "deny",
      "shutdown*": "deny",
      "reboot*": "deny",
      "halt*": "deny",
      "diskutil erase*": "deny",
      ":(){ :|:& }; *": "deny",
      // Block reading .env via bash (best-effort)
      "cat *.env": "deny",
      "head *.env": "deny",
      "tail *.env": "deny",
      "cat *.env.*": "deny",
      // Secret: destructive / value-exposing
      "secret get*": "deny",
      "secret rm*": "deny",
      "secret del*": "deny",
      "secret export*": "deny",
      "secret import*": "deny",
      "secret keychain rm*": "deny",
      "secret keychain delete*": "deny",
      "secret keychain master set*": "deny",
      "secret keychain master rotate*": "deny",
      "secret keychain master forget*": "deny",
      "secret keychain master reveal*": "deny",
    },
    "skill": {
      "*": "ask",
      "customize-opencode": "allow",
      "keychain-secrets": "allow",
      "approach*": "allow",
      "resolve-dependabot-alerts": "allow",
      "manage-github-projects": "allow",
      "git-*": "allow",
      "web-ui": "allow"
    },
    // Custom GitHub Project tools (tools/github_project.ts) — board + issue-lifecycle ops, no delete
    "github_project_create": "allow",
    "github_project_field_ensure": "allow",
    "github_project_item_add": "allow",
    "github_project_item_set": "allow",
    "github_project_item_list": "allow",
    "github_project_item_note": "allow",
    "github_project_item_promote": "allow",
    "github_project_view_ensure": "allow",
    "github_project_issue_link": "allow",
    "github_project_issue_develop": "allow",
    // Custom git workflow tools (tools/git.ts) — read/index only, no commit/push/merge
    "git_secret_scan": "allow",
    "git_stage_hunks": "allow",
    "git_provenance": "allow",
    "git_related_scan": "allow",
    "git_history_digest": "allow",
    "git_amend_check": "allow",
    "git_commit_lint": "allow",
  },
  "mcp": {
    "zai-mcp-server": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@z_ai/mcp-server"
      ],
      "enabled": false,
      "environment": {
        "Z_AI_API_KEY": "{env:ZAI_CODING_PLAN_API_KEY}",
        "Z_AI_MODE": "ZAI"
      }
    },
    "zread": {
      "type": "remote",
      "url": "https://api.z.ai/api/mcp/zread/mcp",
      "enabled": false,
      "headers": {
        "Authorization": "Bearer {env:ZAI_CODING_PLAN_API_KEY}"
      }
    },
    "web-search-prime": {
      "type": "remote",
      "url": "https://api.z.ai/api/mcp/web_search_prime/mcp",
      "enabled": false,
      "headers": {
        "Authorization": "Bearer {env:ZAI_CODING_PLAN_API_KEY}"
      }
    },
    "web-reader": {
      "type": "remote",
      "url": "https://api.z.ai/api/mcp/web_reader/mcp",
      "enabled": false,
      "headers": {
        "Authorization": "Bearer {env:ZAI_CODING_PLAN_API_KEY}"
      }
    },
    "blender-mcp": {
      "type": "local",
      "command": [
        "uvx",
        "blender-mcp"
      ],
      "enabled": false,
      "environment": {
        "BLENDER_HOST": "localhost",
        "BLENDER_PORT": "9876"
      }
    },
    "21st-dev": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@21st-dev/magic@latest"
      ],
      "enabled": false,
      "environment": {
        "API_KEY": "{env:MAGIC_API_KEY}"
      }
    }
  }
}
