      "resource": "terraform state list*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "terraform fmt -check*",
      "effect": "allow"
    },
    // Agent Browser
    {
      "action": "shell",
      "resource": "agent-browser *",
      "effect": "allow"
    },
    // Secret (read-only subcommands)
    {
      "action": "shell",
      "resource": "secret ls*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "secret list*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "secret show *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "secret projects*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "secret help*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "secret keychain ls*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "secret keychain master status*",
      "effect": "allow"
    },
    // Deny block pinned last (not overridden by allows above)
    {
      "action": "shell",
      "resource": "sudo *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "wget *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "dd *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "mkfs*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "shutdown*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "reboot*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "halt*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "diskutil erase*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": ":(){ :|:& }; *",
      "effect": "deny"
    },
    // Block reading .env via bash (best-effort)
    {
      "action": "shell",
      "resource": "cat *.env",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "head *.env",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "tail *.env",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "cat *.env.*",
      "effect": "deny"
    },
    // Secret: destructive / value-exposing
    {
      "action": "shell",
      "resource": "secret get*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "secret env*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "secret rm*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "secret del*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "secret export*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "secret import*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "secret keychain rm*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "secret keychain delete*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "secret keychain master set*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "secret keychain master rotate*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "secret keychain master forget*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "secret keychain master reveal*",
      "effect": "deny"
    },
    {
      "action": "skill",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "skill",
      "resource": "customize-opencode",
      "effect": "allow"
    },
    {
      "action": "skill",
      "resource": "keychain-secrets",
      "effect": "allow"
    },
    {
      "action": "skill",
      "resource": "approach*",
      "effect": "allow"
    },
    {
      "action": "skill",
      "resource": "resolve-dependabot-alerts",
      "effect": "allow"
    },
    {
      "action": "skill",
      "resource": "manage-github-projects",
      "effect": "allow"
    },
    {
      "action": "skill",
      "resource": "git-*",
      "effect": "allow"
    },
    {
      "action": "skill",
      "resource": "japanese-*",
      "effect": "allow"
    },
    // The Claude desktop app syncs its skills into ~/.agents/skills/synced/,
    // which OpenCode reads through ~/.claude/skills. These need tools only
    // that app has (its browser, Claude in Chrome, computer use, connectors,
    // memory), so deny hides them from the model instead of failing.
    {
      "action": "skill",
      "resource": "built-in-browser",
      "effect": "deny"
    },
    {
      "action": "skill",
      "resource": "chrome-browser",
      "effect": "deny"
    },
    {
      "action": "skill",
      "resource": "computer-use",
      "effect": "deny"
    },
    {
      "action": "skill",
      "resource": "docs",
      "effect": "deny"
    },
    {
      "action": "skill",
      "resource": "import-memory",
      "effect": "deny"
    },
    {
      "action": "skill",
      "resource": "morning",
      "effect": "deny"
    },
    // Custom GitHub Project tools (lib/custom-tools/github_project.ts) — board + issue-lifecycle ops, no delete
    {
      "action": "github_project_create",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "github_project_field_ensure",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "github_project_item_add",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "github_project_item_set",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "github_project_item_list",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "github_project_item_note",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "github_project_item_promote",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "github_project_view_ensure",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "github_project_issue_link",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "github_project_issue_develop",
      "resource": "*",
      "effect": "allow"
    },
    // Custom git workflow tools (lib/custom-tools/git/) — read/index only,
    // except git_commit (staged changes only; no amend, no --no-verify),
    // git_worktree (never discards changes; deletes landed branches only) and
    // git_verify_commits (runs a given command: ask). No push/merge/rewrite.
    // Plan, Explore, Review and Debug deny git_commit and git_worktree themselves.
    {
      "action": "git_commit",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "git_worktree",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "git_state",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "git_conflicts",
      "resource": "*",
      "effect": "allow"
    },
    // Runs an arbitrary command at each commit, outside the shell rules: ask.
    {
      "action": "git_verify_commits",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "git_secret_scan",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "git_stage_hunks",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "git_provenance",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "git_related_scan",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "git_history_digest",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "git_amend_check",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "git_commit_lint",
      "resource": "*",
      "effect": "allow"
    },
    // Pull-request status and CI wait (lib/custom-tools/gh.ts) — read-only
    {
      "action": "gh_pr_status",
      "resource": "*",
      "effect": "allow"
    },
    // Custom X search tool (lib/custom-tools/x.ts) — xAI server-side x_search, read-only external query
    {
      "action": "x_search",
      "resource": "*",
      "effect": "allow"
    },
    // Rendered web UI checks (lib/custom-tools/web_ui.ts) — writes only to a .agent/ draft or scratch
    {
      "action": "web_ui_check",
      "resource": "*",
      "effect": "allow"
    },
  ],
  // Hard denies that no agent rule, saved "Allow always" or project config can
  // lift: an agent whose shell rules start with "*": ask would otherwise turn
  // the global denies above back into prompts. Policies only tighten; keep
  // the matching permission denies too, since Hermes copies build's denies
  // into its session rulesets. Custom plugin tools bypass both layers.
  // Invalid statements are dropped with a server-log warning.
  "experimental": {
    "policies": [
      {
        "action": "permission",
        "resource": "shell:sudo *",
        "effect": "deny"
      },
      {
        "action": "permission",
        "resource": "shell:dd *",
        "effect": "deny"
      },
      {
        "action": "permission",
        "resource": "shell:mkfs*",
        "effect": "deny"
      },
      {
        "action": "permission",
        "resource": "shell:diskutil erase*",
        "effect": "deny"
      },
      {
        "action": "permission",
        "resource": "shell:shutdown*",
        "effect": "deny"
      },
      {
        "action": "permission",
        "resource": "shell:reboot*",
        "effect": "deny"
      },
      {
        "action": "permission",
        "resource": "shell:halt*",
        "effect": "deny"
      },
      // Environment dumps: the service environment holds API keys.
      {
        "action": "permission",
        "resource": "shell:printenv*",
        "effect": "deny"
      },
      {
        "action": "permission",
        "resource": "shell:env",
        "effect": "deny"
      },
      {
        "action": "permission",
        "resource": "shell:env -0*",
        "effect": "deny"
      },
      // Keychain secrets: value-exposing and destructive subcommands.
      {
        "action": "permission",
        "resource": "shell:secret get*",
        "effect": "deny"
      },
      {
        "action": "permission",
        "resource": "shell:secret env*",
        "effect": "deny"
      },
      {
        "action": "permission",
        "resource": "shell:secret export*",
        "effect": "deny"
      },
      {
        "action": "permission",
        "resource": "shell:secret import*",
        "effect": "deny"
      },
      {
        "action": "permission",
        "resource": "shell:secret rm*",
        "effect": "deny"
      },
      {
        "action": "permission",
        "resource": "shell:secret del*",
        "effect": "deny"
      },
      {
        "action": "permission",
        "resource": "shell:secret keychain rm*",
        "effect": "deny"
      },
      {
        "action": "permission",
        "resource": "shell:secret keychain delete*",
        "effect": "deny"
      },
      {
        "action": "permission",
        "resource": "shell:secret keychain master set*",
        "effect": "deny"
      },
      {
        "action": "permission",
        "resource": "shell:secret keychain master rotate*",
        "effect": "deny"
      },
      {
        "action": "permission",
        "resource": "shell:secret keychain master forget*",
        "effect": "deny"
      },
      {
        "action": "permission",
        "resource": "shell:secret keychain master reveal*",
        "effect": "deny"
      },
      // GitHub: irreversible deletion and token disclosure.
      {
        "action": "permission",
        "resource": "shell:gh repo delete*",
        "effect": "deny"
      },
      {
        "action": "permission",
        "resource": "shell:gh auth token*",
        "effect": "deny"
      },
      {
        "action": "permission",
        "resource": "shell:gh auth status*--show-token*",
        "effect": "deny"
      },
      {
        "action": "permission",
        "resource": "shell:gh auth status* -t*",
        "effect": "deny"
      },
    ],
  },
  "mcp": {
    "servers": {
      "blender-mcp": {
        "type": "local",
        "command": [
          "uvx",
          "blender-mcp"
        ],
        "disabled": true,
        "environment": {
          "BLENDER_HOST": "localhost",
          "BLENDER_PORT": "9876",
        },
      },
      "grep": {
        "type": "remote",
        "url": "https://mcp.grep.app"
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "deepwiki": {
        "type": "remote",
        "url": "https://mcp.deepwiki.com/mcp"
      },
    },
  },
}
