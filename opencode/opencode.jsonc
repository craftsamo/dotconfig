      "resource": "brew --version*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "terraform validate*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "terraform plan*",
      "effect": "allow"
    },
    {
