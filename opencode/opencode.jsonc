{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-claude-auth@latest",
    "@slkiser/opencode-quota"
  ],
  "instructions": [
    "instructions/*.txt",
    "instructions/*.md"
  ],
  "provider": {
    "openrouter": {
      "models": {
        "glm-5.2": {
          "name": "GLM-5.2",
          "variants": {
            "high": {
              "reasoningEffort": "high",
            },
            "max": {
              "reasoningEffort": "max",
            },
          }
        }
      }
    }
  },
  "agent": {
    "explore": {
      "hidden": true,
    },
    "general": {
      "hidden": true,
    },
  },
  "permission": {
    "edit": "ask",
    "bash": {
      "*": "ask",
      "sudo *": "deny",
      "wget *": "deny",
      "dd *": "deny",
      ":(){ :|:& }; *": "deny",
      "ls*": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "stat *": "allow",
      "file *": "allow",
      "du *": "allow",
      "df*": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "jq *": "allow",
      "pwd*": "allow",
      "which *": "allow",
      "whoami*": "allow",
      "uname*": "allow",
      "date*": "allow",
      // GIT
      "git *": "allow",
      "git push*": "ask",
      "git rebase*": "ask",
      "git reset*": "ask",
      "git checkout*": "ask",
      "git restore*": "ask",
      "git clean*": "ask",
      "git commit*": "ask",
      "git merge*": "ask",
      "git revert*": "ask",
      "git cherry-pick*": "ask",
      "git config*": "ask",
      "agent-browser *": "allow",
      "secret ls*": "allow",
      "secret list*": "allow",
      "secret show *": "allow",
      "secret projects*": "allow",
      "secret help*": "allow",
      "secret keychain ls*": "allow",
      "secret keychain master status*": "allow",
      "secret get*": "deny",
      "secret rm*": "deny",
      "secret del*": "deny",
      "secret export*": "deny",
      "secret import*": "deny",
      "secret keychain rm*": "deny",
      "secret keychain delete*": "deny",
      "secret keychain master set*": "deny",
      "secret keychain master rotate*": "deny",
      "secret keychain master forget*": "deny",
      "secret keychain master reveal*": "deny",
    },
    "skill": {
      "*": "ask",
      "customize-opencode": "allow",
      "keychain-secrets": "allow",
      "approach": "allow"
    },
  },
}
