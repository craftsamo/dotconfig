{
  "$schema": "https://opencode.ai/tui.json",
  "plugin": [
    "@slkiser/opencode-quota@3.11.1"
  ],
  "theme": "lucent-orng",
  "keybinds": {
    // Mobile-friendly input: Enter inserts a newline; Shift+Enter submits.
    "input_submit": "shift+return",
    "input_newline": "return",
    // Open the "Move session" dialog (worktree switch/create). Default is unbound.
    "session_move": "<leader>w",
    // New worktree in the Move dialog. Default ctrl+m collides with Enter (CR) in terminals.
    "dialog.move_session.new": "ctrl+o"
  }
}
